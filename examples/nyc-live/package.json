{
  "name": "nyc-live",
  "version": "0.1.0",
  "description": "Lower Manhattan, live, in 3D: the example app a nightwatch run builds overnight.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
