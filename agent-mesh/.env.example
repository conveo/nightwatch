# Copy to agent-mesh/.env to set defaults for `pnpm daemon`, `pnpm cli` and `pnpm ui`.

# The Redis broker the daemon connects to. Required.
#   One machine:   a local Redis, e.g. `docker compose up -d` at the repo root.
#   Several hosts: a Redis every host can reach. Use TLS (rediss://) unless it is on
#                  loopback, and keep it on a private network (the mesh has no auth).
# Only the daemon connects to Redis. Agents use the daemon's local Unix socket.
AGENT_MESH_REDIS_URL=redis://localhost:6379

# Optional. Prefix for every mesh key in Redis (default "mesh"). Use a separate
# prefix for tests so they never touch real traffic.
# AGENT_MESH_PREFIX=mesh

# Optional. Where the daemon keeps local state: inbox files, cursors, the socket.
# Use absolute paths: a .env file does not expand ~.
# AGENT_MESH_HOME=/home/you/.agent-mesh
# AGENT_MESH_SOCK=/home/you/.agent-mesh/daemon.sock

# Optional. The host name shown in the roster (default: $HOSTNAME).
# AGENT_MESH_HOSTNAME=host-a

# Optional. The dashboard port (default 4747) and the base directory for relative
# plan paths in the Plans tab (default: the checkout the dashboard runs from).
# AGENT_MESH_UI_PORT=4747
# AGENT_MESH_PLANS_ROOT=/path/to/repo

# Optional. More directories the Plans tab may read plans from (":"-separated).
# By default only the dashboard's checkout and its git worktrees are readable.
# AGENT_MESH_PLANS_ROOTS=/path/to/plans:/path/to/other-repo

# Optional. Extra Host header names the dashboard accepts (comma-separated), for a
# reverse proxy that forwards its own name. The dashboard has no authentication.
# AGENT_MESH_UI_ALLOWED_HOSTS=mesh.internal

# Optional. The mesh console (docs/CONSOLE.md). Everything but the assistant works
# without a key. With OPENAI_API_KEY set, chat turns, recapped messages and voice
# audio go to OpenAI.
# AGENT_MESH_OPERATOR_ID=operator
# OPENAI_API_KEY=
# AGENT_MESH_PUSH_SUBJECT=mailto:you@example.com
# For a phone through `tailscale serve`, also set AGENT_MESH_UI_ALLOWED_HOSTS above:
# AGENT_MESH_UI_ALLOWED_USERS=you@example.com

# Optional. Path to the `claude` binary, for the older claude-resume transport.
# AGENT_MESH_CLAUDE_BIN=claude

# Per agent: each agent process sets its own stable id (the CLI reads it).
# Inside an agent session the id is derived from worktree, host and session instead.
# AGENT_MESH_ID=worker-a
