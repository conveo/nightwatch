 .plan-md th { background: color-mix(in oklch, var(--card) 70%, transparent); }
+
+/* ── mobile console ───────────────────────────────────────────────────────────
+   Only the phone build uses these. The desktop dashboard never mounts
+   `.mesh-mobile`, so nothing here can reach it. */
+
+.mesh-mobile {
+  /* 100dvh, not 100vh: iOS Safari's vh is the tallest the viewport ever gets, so
+     a vh-sized app hides its own composer behind the URL bar until you scroll. */
+  height: 100dvh;
+  /* A rubber-band scroll on the page drags the whole app under the status bar and
+     makes a fixed composer look broken; contain it to the panes that scroll. */
+  overscroll-behavior: none;
+  -webkit-tap-highlight-color: transparent;
+}
+
+.mesh-mobile .mesh-scroll {
+  overscroll-behavior: contain;
+  -webkit-overflow-scrolling: touch;
+}
+
+/* Safari zooms the page when a focused input's text is under 16px, and never
+   zooms back out. Every control the thumb can land on stays at 16px. */
+.mesh-mobile input,
+.mesh-mobile textarea,
+.mesh-mobile select {
+  font-size: 16px;
+}
+
+.mesh-safe-top {
+  padding-top: max(env(safe-area-inset-top), 0.5rem);
+}
+.mesh-safe-bottom {
+  padding-bottom: max(env(safe-area-inset-bottom), 0.5rem);
+}
+
+/* The mic's living state: a slow breath while listening, a faster pulse while the
+   model is talking back. Both respect a reduced-motion preference. */
+@keyframes meshbreathe {
+  0%,
+  100% {
+    box-shadow: 0 0 0 0 color-mix(in oklch, var(--primary) 45%, transparent);
+  }
+  50% {
+    box-shadow: 0 0 0 14px color-mix(in oklch, var(--primary) 0%, transparent);
+  }
+}
+.animate-meshbreathe {
+  animation: meshbreathe 2.6s ease-out infinite;
+}
+.animate-meshbreathe-fast {
+  animation: meshbreathe 1.1s ease-out infinite;
+}
+@media (prefers-reduced-motion: reduce) {
+  .animate-meshbreathe,
+  .animate-meshbreathe-fast,
+  .animate-meshpulse {
+    animation: none;
+  }
+}
+
+/* Markdown coming out of the assistant (Streamdown) — tuned for a 390px column. */
+.mesh-mobile .mesh-prose > * {
+  margin: 0;
+}
+.mesh-mobile .mesh-prose {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  font-size: 15px;
+  line-height: 1.55;
+}
+.mesh-mobile .mesh-prose ul,
+.mesh-mobile .mesh-prose ol {
+  padding-left: 20px;
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+}
+.mesh-mobile .mesh-prose code {
+  background: var(--muted);
+  padding: 1px 5px;
+  border-radius: 4px;
+  font-family: var(--font-mono);
+  font-size: 13px;
+  overflow-wrap: anywhere;
+}
+.mesh-mobile .mesh-prose pre {
+  background: var(--muted);
+  padding: 10px;
+  border-radius: var(--radius);
+  overflow: auto;
+}
+.mesh-mobile .mesh-prose pre code {
+  background: none;
+  padding: 0;
+}
+.mesh-mobile .mesh-prose a {
+  color: var(--primary);
+  overflow-wrap: anywhere;
+}
