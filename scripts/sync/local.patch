--- /dev/null
+++ b/agent-mesh/dashboard/src/lib/useDesktopView.ts
@@ -0,0 +1,38 @@
+import { usePersistedState } from "./usePersistedState"
+
+// Console first, and the default: talking to the mesh is what you want on open, and
+// the roster is what you want when you already know which agent you are chasing.
+export const DESKTOP_VIEWS = [
+  { id: "console", label: "Console" },
+  { id: "roster", label: "Roster" },
+  { id: "plans", label: "Plans" },
+] as const
+
+export type DesktopView = (typeof DESKTOP_VIEWS)[number]["id"]
+
+const KEY = "view-v2"
+const LEGACY_KEY = "agent-mesh:view"
+
+/**
+ * The selected tab, persisted — with a one-time read of the old two-tab key.
+ *
+ * The migration is not cosmetic. `usePersistedState` writes on mount, so the old
+ * `view` key holds "roster" for everyone who ever opened the dashboard, whether they
+ * chose it or it was simply the default. That value is therefore NOT evidence of a
+ * preference, and honouring it would mean nobody ever lands on the new default.
+ * "plans" is different: it could only ever have been reached by clicking, so it is a
+ * real choice and is carried over. Everything else starts on the console, and the
+ * first deliberate click writes the new key and settles it for good.
+ */
+export function useDesktopView(): [DesktopView, (v: DesktopView) => void] {
+  const [view, setView] = usePersistedState<DesktopView>(KEY, legacyChoice() ?? "console")
+  return [view, setView]
+}
+
+function legacyChoice(): DesktopView | null {
+  try {
+    return localStorage.getItem(LEGACY_KEY) === '"plans"' ? "plans" : null
+  } catch {
+    return null // quota / private mode — treat as no stored preference
+  }
+}
diff --git a/agent-mesh/dashboard/src/lib/useIsMobile.ts b/agent-mesh/dashboard/src/lib/useIsMobile.ts
new file mode 100644
index 0000000..cb5e693
--- /dev/null
+++ b/agent-mesh/dashboard/src/lib/useIsMobile.ts
@@ -0,0 +1,45 @@
+import { useEffect, useState } from "react"
+
+// Landing on this box should open the phone console on a phone and the desktop
+// dashboard everywhere else.
+//
+// Width alone is wrong in both directions: a narrowed desktop window is still a
+// desktop (mouse, keyboard, a roster that wants the space), and a tablet in
+// portrait is not a phone. So both a small viewport AND a coarse pointer are
+// required — and `?mobile=1` / `?mobile=0` overrides either way, which is the only
+// way to exercise the phone build from a laptop.
+const MOBILE_MAX_WIDTH = 820
+
+function forcedFromQuery(): boolean | null {
+  const raw = new URLSearchParams(window.location.search).get("mobile")
+  if (raw === "1" || raw === "true") {
+    return true
+  }
+  if (raw === "0" || raw === "false") {
+    return false
+  }
+  return null
+}
+
+function detect(): boolean {
+  const forced = forcedFromQuery()
+  if (forced != null) {
+    return forced
+  }
+  return window.matchMedia(`(max-width: ${MOBILE_MAX_WIDTH}px)`).matches && window.matchMedia("(pointer: coarse)").matches
+}
+
+export function useIsMobile(): boolean {
+  const [isMobile, setIsMobile] = useState(detect)
+
+  useEffect(() => {
+    // Rotating a phone changes the width query; a forced override pins it and the
+    // listener is then just a no-op that keeps the branch uniform.
+    const mql = window.matchMedia(`(max-width: ${MOBILE_MAX_WIDTH}px)`)
+    const onChange = () => setIsMobile(detect())
+    mql.addEventListener("change", onChange)
+    return () => mql.removeEventListener("change", onChange)
+  }, [])
+
+  return isMobile
+}
