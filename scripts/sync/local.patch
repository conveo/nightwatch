@@ -0,0 +1,161 @@
+// The console as a desktop tab: the same views the phone uses, laid out for width.
+//
+// A phone shows one thing at a time behind a back button. A monitor should not show
+// the same single column stretched across 2560px — so here the conversation list, the
+// chat and one agent's raw thread are all on screen at once, and the model's
+// `open_thread` opens the right pane *beside* the chat instead of navigating away
+// from it. Nothing is forked to achieve that: Console, Threads, ThreadView,
+// VoiceSession and both hooks are the same modules the phone shell mounts.
+
+import { PanelRightClose, RefreshCw } from "lucide-react"
+import { useCallback, useState } from "react"
+import { StatusDot } from "@/components/ui/core"
+import { cn } from "@/lib/utils"
+import { splitAgentId } from "./console-api"
+import { Console } from "./Console"
+import { LiveThread } from "./LiveThread"
+import { Threads } from "./Threads"
+import { ChatListButton, NewChatButton } from "./ChatSwitcher"
+import { useConsoleData } from "./useConsoleData"
+import { useConversations } from "./useConversations"
+import { useArrivals } from "./useArrivals"
+import { useInboxStream } from "./useInboxStream"
+import { useVoiceController } from "./useVoiceController"
+import { VoiceSession } from "./VoiceSession"
+
+export function DesktopConsole() {
+  const data = useConsoleData()
+  const voice = useVoiceController()
+  // One subscription per shell, not per view — an answer is most likely to land
+  // while the operator is looking at something else.
+  const { arrival } = useInboxStream()
+  const chats = useConversations()
+  const arrivalSink = useArrivals({ arrival, activeConversation: chats.active, onSaved: chats.refresh })
+  // Opens on the broadcast channel rather than empty: on a wide screen an unused
+  // third column is worse than a live one, and mesh-wide traffic is the thing worth
+  // watching while you type. Selecting an agent swaps it; the close button collapses
+  // it and gives the chat the full width.
+  const [peer, setPeer] = useState<string | null>("broadcast")
+
+  const openThread = useCallback((id: string) => setPeer(id), [])
+
+  if (data.configError != null) {
+    return (
+      <div className="flex h-full flex-col items-center justify-center gap-2 text-center">
+        <p className="text-sm font-medium text-destructive">Can't reach the mesh daemon</p>
+        <p className="font-mono text-xs text-muted-foreground">{data.configError}</p>
+      </div>
+    )
+  }
+  if (data.config == null) {
+    return <div className="grid h-full place-items-center text-sm text-muted-foreground">connecting…</div>
+  }
+
+  const agent = peer != null ? data.agents.find((a) => a.id === peer) : undefined
+
+  return (
+    <div className="flex h-full min-h-0">
+      {/* Conversations + roster. Same component the phone uses full-screen; it reads
+          as a mail sidebar at this width without a second implementation. */}
+      <aside className="flex w-[21rem] shrink-0 flex-col border-r border-border/70 bg-card/20">
+        <div className="flex h-10 shrink-0 items-center gap-2 border-b border-border/60 px-3">
+          <span className="text-[11px] font-medium uppercase tracking-wide text-muted-foreground">Conversations</span>
+          {data.unread > 0 && (
+            <span className="rounded-full bg-primary px-1.5 text-[10.5px] font-semibold text-primary-foreground tabular">{data.unread}</span>
+          )}
+          <button
+            aria-label="Refresh"
+            className="ml-auto grid size-6 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-accent/60 hover:text-foreground"
+            onClick={data.refresh}
+            type="button"
+          >
+            <RefreshCw className="size-3.5" />
+          </button>
+        </div>
+        <Threads agents={data.agents} hostname={data.config.hostname} onOpen={openThread} peers={data.peers} sentTo={data.sentTo} />
+      </aside>
+
+      <main className="flex min-w-0 flex-1 flex-col">
+        <div className="flex h-10 shrink-0 items-center gap-2 border-b border-border/60 px-3">
+          <NewChatButton compact={false} onNew={chats.create} />
+          {/* null: the desktop topbar already carries the theme toggle and refresh, so
+              repeating them inside the sheet would be two ways to do the same thing. */}
+          <ChatListButton active={chats.active} compact={false} console={null} conversations={chats.list} onSelect={chats.select} />
+          <span className="truncate text-[11px] text-muted-foreground">{chats.list.find((c) => c.id === chats.active)?.title ?? "New chat"}</span>
+        </div>
+        {/* Keyed by conversation: one instance per chat. See Console for why. */}
+        <Console
+          key={chats.active}
+          conversationId={chats.active}
+          onConversationSaved={chats.refresh}
+          activePeer={peer}
+          adoptVoiceRef={voice.adoptRef}
+          arrivalSinkRef={arrivalSink}
+          agents={data.agents}
+          config={data.config}
+          layout="wide"
+          offeredThread={null}
+          onDismissOffered={() => undefined}
+          onOpenOffered={openThread}
+          micError={voice.micError}
+          onOpenThread={openThread}
+          onStartVoice={voice.start}
+          voiceActive={voice.session != null}
+          voiceMessages={voice.messages}
+        />
+        {voice.session != null && (
+          <VoiceSession
+            config={data.config}
+            instructions={voice.session.instructions}
+            onMessages={voice.setMessages}
+            onOpenThread={openThread}
+            onStop={voice.stop}
+            stream={voice.session.stream}
+          />
+        )}
+      </main>
+
+      {peer != null && (
+        <aside className="flex w-[27rem] shrink-0 flex-col border-l border-border/70 bg-card/20">
+          <div className="flex h-10 shrink-0 items-center gap-2 border-b border-border/60 px-3">
+            <div className="min-w-0 flex-1">
+              <p className="truncate font-mono text-[12.5px] font-medium leading-tight">
+                {(() => {
+                  const { scope, leaf } = splitAgentId(peer)
+                  return (
+                    <>
+                      {scope != null && <span className="text-muted-foreground/70">{scope}.</span>}
+                      {leaf}
+                    </>
+                  )
+                })()}
+              </p>
+              <p className="flex items-center gap-1.5 text-[10.5px] text-muted-foreground">
+                {agent != null ? (
+                  <>
+                    <StatusDot status={agent.status} /> {agent.status} · {agent.role}
+                  </>
+                ) : peer === "broadcast" ? (
+                  "mesh-wide channel"
+                ) : peer.startsWith("host:") ? (
+                  "host fan-out · send only"
+                ) : (
+                  "not in the registry"
+                )}
+              </p>
+            </div>
+            <button
+              aria-label="Close thread"
+              className={cn("grid size-6 shrink-0 place-items-center rounded-md text-muted-foreground transition-colors hover:bg-accent/60 hover:text-foreground")}
+              onClick={() => setPeer(null)}
+              type="button"
+            >
+              <PanelRightClose className="size-4" />
+            </button>
+          </div>
+          <LiveThread me={data.me} onSent={() => data.rememberSent(peer)} peer={peer} />
+        </aside>
+      )}
+    </div>
+  )
+}
diff --git a/agent-mesh/dashboard/src/console/LiveThread.tsx b/agent-mesh/dashboard/src/console/LiveThread.tsx
new file mode 100644
index 0000000..1412e0c
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/LiveThread.tsx
@@ -0,0 +1,47 @@
+// One agent's thread, polled while it is on screen. Shared by both shells so the
+// poll interval and the drop-a-tick behaviour can't diverge between them.
+
+import { useEffect, useState } from "react"
+import type { MeshMessage } from "@/lib/api"
+import { consoleApi } from "./console-api"
+import { ThreadView } from "./ThreadView"
+
+const THREAD_MS = 2500
+
+export function LiveThread({ peer, me, onSent }: { peer: string; me: string; onSent: () => void }) {
+  const [state, setState] = useState<{ messages: MeshMessage[]; sendOnly: boolean } | null>(null)
+
+  useEffect(() => {
+    let live = true
+    setState(null)
+    const load = () => {
+      consoleApi.thread({ peer, me }).then(
+        (t) => live && setState({ messages: t.messages, sendOnly: t.sendOnly }),
+        // A dropped poll keeps the last-known thread on screen rather than flashing it
+        // empty; the next good tick repopulates.
+        () => undefined,
+      )
+    }
+    load()
+    const t = setInterval(() => {
+      if (document.visibilityState === "visible") {
+        load()
+      }
+    }, THREAD_MS)
+    return () => {
+      live = false
+      clearInterval(t)
+    }
+  }, [peer, me])
+
+  return (
+    <ThreadView
+      loading={state == null}
+      me={me}
+      messages={state?.messages ?? []}
+      onSent={onSent}
+      peer={peer}
+      sendOnly={state?.sendOnly ?? false}
+    />
+  )
+}
diff --git a/agent-mesh/dashboard/src/console/MessageParts.tsx b/agent-mesh/dashboard/src/console/MessageParts.tsx
new file mode 100644
index 0000000..46beb43
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/MessageParts.tsx
@@ -0,0 +1,250 @@
+// Rendering for the parts of an assistant UIMessage, shared by the typed chat and
+// the voice transcript — both produce plain `UIMessage[]`, so one renderer covers
+// them and a tool call looks the same whether it was typed or spoken.
+
+import { Message, MessageContent, MessageResponse } from "@/components/ai-elements/message"
+import { Reasoning, ReasoningContent, ReasoningTrigger } from "@/components/ai-elements/reasoning"
+import { Tool, ToolContent, ToolHeader, ToolInput, ToolOutput } from "@/components/ai-elements/tool"
+import type { ToolUIPart, UIMessage } from "ai"
+import { useState } from "react"
+import { ChevronRight, Send } from "lucide-react"
+import { TYPE_STYLE } from "@/lib/format"
+import { receiptLabel, useReceipt } from "./useReceipt"
+import { cn } from "@/lib/utils"
+
+// A one-line human summary for the tool chips. The generic Tool card is still
+// available underneath (tap to expand) — this is what you read at a glance while
+// walking, which is most of what this console is for.
+const TOOL_LABEL: Record<string, string> = {
+  list_agents: "Looking up agents",
+  read_thread: "Reading a thread",
+  read_inbox: "Reading your inbox",
+  send_message: "Sending a mesh message",
+  open_thread: "Opening a thread",
+  mesh_overview: "Checking the mesh",
+  inspect_agent: "Inspecting",
+  nudge_agent: "Nudging",
+}
+
+function toolName(type: string): string {
+  return type.startsWith("tool-") ? type.slice("tool-".length) : type
+}
+
+// A tool-call loop reads several threads in a row, and a column of identical
+// "Reading a thread" cards tells you nothing about what it looked at. The argument
+// is the only thing that distinguishes them, so it goes in the title.
+function toolTitle(name: string, input: unknown): string {
+  const label = TOOL_LABEL[name] ?? name
+  const args = (input ?? {}) as { agent?: unknown; to?: unknown; query?: unknown }
+  const subject =
+    typeof args.agent === "string" && args.agent !== ""
+      ? args.agent
+      : typeof args.to === "string" && args.to !== ""
+        ? args.to
+        : typeof args.query === "string" && args.query.trim() !== ""
+          ? `“${args.query.trim()}”`
+          : null
+  return subject == null ? label : `${label} · ${subject}`
+}
+
+/**
+ * A sent message is the one tool result worth promoting out of a collapsed card:
+ * it is the only one with a side effect on the mesh, and the operator needs to see what
+ * actually went out without expanding anything.
+ */
+function SentReceipt({ part }: { part: ToolUIPart }) {
+  const out = part.output as { sent?: boolean; nudged?: boolean; to?: string; type?: string; error?: string; correlationId?: string; at?: string } | undefined
+  // Hooks run before the early returns below: a card that is still streaming, or that
+  // failed, must not change how many hooks this component calls.
+  const sentAt = typeof out?.at === "string" ? Date.parse(out.at) : Number.NaN
+  const receipt = useReceipt({
+    correlationId: out?.sent === true && typeof out.correlationId === "string" ? out.correlationId : "",
+    to: typeof out?.to === "string" ? out.to : "",
+    sentAtMs: Number.isFinite(sentAt) ? sentAt : null,
+  })
+  if (out == null) {
+    return null
+  }
+  // A nudge that was REFUSED (dead or stale recipient) is the most useful receipt of
+  // the lot: it is the difference between "sent" and "reached".
+  if (out.sent !== true && out.nudged !== true) {
+    return (
+      <div className="rounded-lg border border-destructive/40 bg-destructive/10 px-3 py-2 text-[13px] text-destructive">
+        Not sent — {out.error ?? "publish rejected"}
+      </div>
+    )
+  }
+  const input = part.input as { text?: string } | undefined
+  return (
+    <div className="rounded-lg border border-status-online/35 bg-status-online/10 px-3 py-2">
+      <p className="flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-wide text-status-online">
+        <Send className="size-3" /> {out.nudged === true ? "nudged" : `sent · ${out.type ?? ""}`} → <span className="font-mono normal-case tracking-normal">{out.to}</span>
+      </p>
+      {input?.text != null && <p className="mt-1 text-[13px] leading-snug text-foreground/85">{input.text}</p>}
+      {receipt != null && <ReceiptLine receipt={receipt} />}
+    </div>
+  )
+}
+
+function ReceiptLine({ receipt }: { receipt: NonNullable<ReturnType<typeof useReceipt>> }) {
+  const { text, tone } = receiptLabel(receipt)
+  return (
+    <p
+      className={cn(
+        "mt-1.5 text-[11px]",
+        tone === "good" && "text-status-online",
+        tone === "waiting" && "text-muted-foreground",
+        // An honest shrug reads as a shrug. Styling "unknown" like "delivered" is how a
+        // badge starts being believed about things it never knew.
+        tone === "unknown" && "italic text-muted-foreground/70",
+      )}
+    >
+      {text}
+    </p>
+  )
+}
+
+function ToolPart({ part }: { part: ToolUIPart }) {
+  const name = toolName(part.type)
+  const done = part.state === "output-available" || part.state === "output-error"
+
+  if ((name === "send_message" || name === "nudge_agent") && part.state === "output-available") {
+    return <SentReceipt part={part} />
+  }
+  // open_thread has already moved the screen; a card about it would just be noise.
+  if (name === "open_thread") {
+    return null
+  }
+  return (
+    <Tool className="mb-0 border-border/60 bg-card/40">
+      <ToolHeader
+        className="p-2.5"
+        state={part.state}
+        title={toolTitle(name, part.input)}
+        type={part.type}
+      />
+      <ToolContent>
+        <ToolInput input={part.input} />
+        {done && <ToolOutput errorText={part.errorText} output={part.output} />}
+      </ToolContent>
+    </Tool>
+  )
+}
+
+export function AssistantMessage({ message }: { message: UIMessage }) {
+  const isUser = message.role === "user"
+  // A participant turn: sent by an agent, not by the console assistant. It is labelled
+  // with WHO said it, because an unattributed reply in a multi-participant room is
+  // indistinguishable from the assistant having said it.
+  const meta = message.metadata as { author?: string; meshType?: string; at?: string; raw?: MeshRaw[] } | undefined
+  const author = typeof meta?.author === "string" ? meta.author : null
+  const raw = Array.isArray(meta?.raw) ? meta.raw : null
+  // A realtime session opens a user message as soon as it hears audio, before the
+  // transcript arrives — and emits one that stays empty for a cough or a passing
+  // car. Rendering those puts blank bubbles down the thread.
+  const empty = message.parts.every((p) => (p.type === "text" || p.type === "reasoning") && p.text.trim() === "")
+  if (empty) {
+    return null
+  }
+  return (
+    <Message from={message.role}>
+      {author != null && <MeshEntryHeader author={author} at={meta?.at} count={raw?.length ?? 1} meshType={meta?.meshType} />}
+      <MessageContent
+        className={cn(
+          author != null && "rounded-xl border border-border/60 bg-card px-3.5 py-2.5",
+          isUser && "group-[.is-user]:max-w-[88%] group-[.is-user]:rounded-2xl group-[.is-user]:rounded-br-md group-[.is-user]:bg-primary group-[.is-user]:px-3.5 group-[.is-user]:py-2.5 group-[.is-user]:text-[15px] group-[.is-user]:text-primary-foreground",
+          !isUser && "gap-2.5",
+        )}
+      >
+        {message.parts.map((part, i) => {
+          const key = `${message.id}-${i}`
+          if (part.type === "text") {
+            return isUser ? (
+              <p className="whitespace-pre-wrap leading-snug" key={key}>
+                {part.text}
+              </p>
+            ) : (
+              <MessageResponse className="mesh-prose" key={key}>
+                {part.text}
+              </MessageResponse>
+            )
+          }
+          if (part.type === "reasoning") {
+            return (
+              <Reasoning className="w-full" isStreaming={part.state === "streaming"} key={key}>
+                <ReasoningTrigger />
+                <ReasoningContent>{part.text}</ReasoningContent>
+              </Reasoning>
+            )
+          }
+          if (part.type.startsWith("tool-")) {
+            return <ToolPart key={key} part={part as ToolUIPart} />
+          }
+          return null
+        })}
+        {raw != null && <RawMeshDetails raw={raw} />}
+      </MessageContent>
+    </Message>
+  )
+}
+
+type MeshRaw = { id: string; author: string; type: string; at: string; correlationId: string | null; text: string }
+
+function MeshEntryHeader({ author, at, meshType, count }: { author: string; at?: string; meshType?: string; count: number }) {
+  return (
+    <p className="flex items-center gap-1.5 text-[11px]">
+      {meshType != null && (
+        <span className="shrink-0 font-semibold uppercase tracking-wide" style={{ color: TYPE_STYLE[meshType as keyof typeof TYPE_STYLE]?.color }}>
+          {meshType}
+        </span>
+      )}
+      <span className="truncate font-mono text-muted-foreground">{author}</span>
+      {count > 1 && <span className="shrink-0 text-muted-foreground/70">+{count - 1}</span>}
+      {at != null && <span className="ml-auto shrink-0 tabular text-muted-foreground/70">{new Date(at).toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" })}</span>}
+    </p>
+  )
+}
+
+/**
+ * The raw agent message, behind an explicit affordance.
+ *
+ * Collapsed is the default because the recap above is what the operator reads — the timeline has
+ * to be readable without them parsing agent payloads. But the raw is never discarded:
+ * author and correlation are shown with it, so an answer can always be traced to the
+ * request that caused it.
+ */
+function RawMeshDetails({ raw }: { raw: MeshRaw[] }) {
+  const [open, setOpen] = useState(false)
+  return (
+    <div className="mt-1">
+      <button
+        className="flex items-center gap-1 text-[11px] text-muted-foreground transition-colors hover:text-foreground"
+        onClick={() => setOpen((o) => !o)}
+        type="button"
+      >
+        <ChevronRight className={cn("size-3 transition-transform", open && "rotate-90")} />
+        {open ? "Hide" : "Show"} original{raw.length > 1 ? ` (${raw.length})` : ""}
+      </button>
+      {open && (
+        <div className="mt-1.5 flex flex-col gap-2">
+          {raw.map((r) => (
+            <div className="rounded-lg border border-border/60 bg-muted/30 px-2.5 py-2" key={r.id}>
+              <p className="flex flex-wrap items-center gap-x-1.5 text-[10.5px]">
+                <span className="font-semibold uppercase tracking-wide" style={{ color: TYPE_STYLE[r.type as keyof typeof TYPE_STYLE]?.color }}>
+                  {r.type}
+                </span>
+                <span className="truncate font-mono text-muted-foreground">{r.author}</span>
+                <span className="tabular text-muted-foreground/70">{new Date(r.at).toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" })}</span>
+              </p>
+              {/* Markdown, not pre-wrap: `bodyToText` renders a structured body as prose with
+                  bold keys, and the thread view already shows mesh bodies that way. Plain text
+                  here would put literal `**` in front of every field. */}
+              <MessageResponse className="mesh-prose mt-1 text-[12.5px] leading-snug text-foreground/85">{r.text}</MessageResponse>
+              {r.correlationId != null && <p className="mt-1 font-mono text-[10px] text-muted-foreground/70">corr {r.correlationId}</p>}
+            </div>
+          ))}
+        </div>
+      )}
+    </div>
+  )
+}
diff --git a/agent-mesh/dashboard/src/console/MobileApp.tsx b/agent-mesh/dashboard/src/console/MobileApp.tsx
new file mode 100644
index 0000000..ab41634
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/MobileApp.tsx
@@ -0,0 +1,230 @@
+// The phone shell. Chat-first: you land on one conversation with the mesh and push
+// sideways into a specific agent's thread when you want the raw traffic.
+//
+// It is a separate SHELL from the desktop console, not a separate implementation —
+// the views, the data hook and the voice controller are shared, and only the layout
+// differs. A phone wants one thing at a time behind a back button; a 2560px monitor
+// wants the list, the chat and the thread at once.
+
+import { ChevronLeft, MessagesSquare, Moon, RefreshCw, Sun } from "lucide-react"
+import { useCallback, useState } from "react"
+import type { AgentRecord } from "@/lib/api"
+import { useTheme } from "@/lib/useTheme"
+import { cn } from "@/lib/utils"
+import { StatusDot } from "@/components/ui/core"
+import { splitAgentId } from "./console-api"
+import { Console } from "./Console"
+import { LiveThread } from "./LiveThread"
+import { Threads } from "./Threads"
+import { ChatListButton, NewChatButton } from "./ChatSwitcher"
+import { useConsoleData } from "./useConsoleData"
+import { useConversations } from "./useConversations"
+import { useArrivals } from "./useArrivals"
+import { useInboxStream } from "./useInboxStream"
+import { useVoiceController } from "./useVoiceController"
+import { VoiceSession } from "./VoiceSession"
+
+type View = { kind: "console" } | { kind: "threads" } | { kind: "thread"; peer: string }
+
+export default function MobileApp() {
+  const { theme, toggle } = useTheme()
+  const data = useConsoleData()
+  // Voice is owned by the shell, not by the console view — the model's own
+  // open_thread navigates away from it mid-sentence. See useVoiceController.
+  const voice = useVoiceController()
+  // One subscription per shell, not per view — an answer is most likely to land
+  // while the operator is looking at something else.
+  const { arrival } = useInboxStream()
+  const chats = useConversations()
+  const arrivalSink = useArrivals({ arrival, activeConversation: chats.active, onSaved: chats.refresh })
+  const [view, setView] = useState<View>({ kind: "console" })
+
+  // Navigating on the model's say-so is what pulled the operator out of the chat: the prompt
+  // told it to "follow the conversation", and on a phone that means leaving the
+  // conversation. An agent the assistant mentions is now OFFERED — a tappable chip in
+  // the thread — and only a tap navigates. Their attention is theirs to move.
+  const [offered, setOffered] = useState<string | null>(null)
+  const offerThread = useCallback((peer: string) => setOffered(peer), [])
+  const openThread = useCallback((peer: string) => {
+    setOffered(null)
+    setView({ kind: "thread", peer })
+  }, [])
+
+  if (data.configError != null) {
+    return (
+      <div className="mesh-mobile flex flex-col items-center justify-center gap-2 px-6 text-center">
+        <p className="text-sm font-medium text-destructive">Can't reach the mesh daemon</p>
+        <p className="font-mono text-xs break-all text-muted-foreground">{data.configError}</p>
+      </div>
+    )
+  }
+  if (data.config == null) {
+    return <div className="mesh-mobile grid place-items-center text-sm text-muted-foreground">connecting…</div>
+  }
+
+  return (
+    <div className="mesh-mobile relative z-10 flex flex-col">
+      <Header
+        agents={data.agents}
+        onBack={view.kind === "console" ? null : () => setView(view.kind === "thread" ? { kind: "threads" } : { kind: "console" })}
+        onRefresh={data.refresh}
+        onThreads={() => setView({ kind: "threads" })}
+        onToggleTheme={toggle}
+        online={data.online}
+        theme={theme}
+        chats={{ active: chats.active, list: chats.list, onNew: chats.create, onSelect: chats.select }}
+        total={data.agents.length}
+        unread={data.unread}
+        view={view}
+      />
+
+      {/* The console stays MOUNTED and is hidden rather than swapped out: unmounting
+          it would throw away the whole typed conversation (and its scroll position)
+          every time the operator tapped into a thread and back. */}
+      <div className={cn("flex min-h-0 flex-1 flex-col", view.kind !== "console" && "hidden")}>
+        {/* Keyed by conversation: one instance per chat. See Console for why. */}
+        <Console
+          key={chats.active}
+          activePeer={view.kind === "thread" ? view.peer : null}
+          adoptVoiceRef={voice.adoptRef}
+          arrivalSinkRef={arrivalSink}
+          conversationId={chats.active}
+          onConversationSaved={chats.refresh}
+          agents={data.agents}
+          config={data.config}
+          layout="phone"
+          micError={voice.micError}
+          offeredThread={offered}
+          onDismissOffered={() => setOffered(null)}
+          onOpenOffered={openThread}
+          onOpenThread={offerThread}
+          onStartVoice={voice.start}
+          voiceActive={voice.session != null}
+          voiceMessages={voice.messages}
+        />
+      </div>
+      {view.kind === "threads" && (
+        <Threads agents={data.agents} hostname={data.config.hostname} onOpen={openThread} peers={data.peers} sentTo={data.sentTo} />
+      )}
+      {view.kind === "thread" && <LiveThread me={data.me} onSent={() => data.rememberSent(view.peer)} peer={view.peer} />}
+
+      {voice.session != null && (
+        <VoiceSession
+          config={data.config}
+          instructions={voice.session.instructions}
+          onMessages={voice.setMessages}
+          onOpenThread={offerThread}
+          onStop={voice.stop}
+          stream={voice.session.stream}
+        />
+      )}
+    </div>
+  )
+}
+
+function Header(args: {
+  view: View
+  agents: AgentRecord[]
+  online: number
+  total: number
+  unread: number
+  theme: "light" | "dark"
+  onBack: (() => void) | null
+  onThreads: () => void
+  onRefresh: () => void
+  onToggleTheme: () => void
+  chats: { active: string; list: import("./useConversations").ConversationSummary[]; onNew: () => string; onSelect: (id: string) => void } | null
+}) {
+  const peer = args.view.kind === "thread" ? args.view.peer : null
+  const agent = peer != null ? args.agents.find((a) => a.id === peer) : undefined
+  const { scope, leaf } = peer != null ? splitAgentId(peer) : { scope: null, leaf: "" }
+
+  return (
+    <header className="mesh-safe-top z-20 flex items-center gap-2 border-b border-border/70 bg-background/85 px-2 pb-2 backdrop-blur-xl">
+      {args.onBack != null ? (
+        <button aria-label="Back" className="grid size-9 shrink-0 place-items-center rounded-full active:bg-accent" onClick={args.onBack} type="button">
+          <ChevronLeft className="size-5" />
+        </button>
+      ) : (
+        <span className="grid size-9 shrink-0 place-items-center">
+          <span className="size-2.5 rounded-full bg-primary" />
+        </span>
+      )}
+
+      <div className="min-w-0 flex-1 overflow-hidden">
+        {peer != null ? (
+          <>
+            <p className="truncate font-mono text-[14px] font-medium leading-tight">
+              {scope != null && <span className="text-muted-foreground/70">{scope}.</span>}
+              {leaf}
+            </p>
+            <p className="flex items-center gap-1.5 text-[11px] text-muted-foreground">
+              {agent != null ? (
+                <>
+                  <StatusDot status={agent.status} /> {agent.status} · {agent.role}
+                </>
+              ) : peer === "broadcast" ? (
+                "mesh-wide channel"
+              ) : peer.startsWith("host:") ? (
+                "host fan-out · send only"
+              ) : (
+                "not in the registry"
+              )}
+            </p>
+          </>
+        ) : (
+          <>
+            {/* Truncate rather than wrap: with the chat controls beside it the title
+                has little room on a 393px screen, and a two-line header pushes the
+                whole conversation down. */}
+            <p className="truncate text-[15px] font-medium leading-tight">{args.view.kind === "threads" ? "Conversations" : "agent mesh"}</p>
+            <p className="truncate text-[11px] text-muted-foreground tabular">{args.online} online</p>
+          </>
+        )}
+      </div>
+
+      {args.view.kind === "console" && args.chats != null && (
+        <>
+          <NewChatButton compact onNew={args.chats.onNew} />
+          <ChatListButton
+            active={args.chats.active}
+            compact
+            console={{ theme: args.theme, onToggleTheme: args.onToggleTheme, onRefresh: args.onRefresh }}
+            conversations={args.chats.list}
+            onSelect={args.chats.onSelect}
+          />
+        </>
+      )}
+      {args.view.kind === "console" && (
+        <button aria-label="Conversations" className="relative grid size-9 shrink-0 place-items-center rounded-full active:bg-accent" onClick={args.onThreads} type="button">
+          <MessagesSquare className="size-5" />
+          {args.unread > 0 && (
+            <span className="absolute right-0.5 top-0.5 min-w-4 rounded-full bg-primary px-1 text-[10px] font-semibold leading-4 text-primary-foreground tabular">
+              {args.unread > 99 ? "99+" : args.unread}
+            </span>
+          )}
+        </button>
+      )}
+      {/* These two breakpoints FIX A REPORTED BUG. Do not delete them while tidying
+          breakpoints.
+          Adding New and Chats put seven items in this header, and every one of them is
+          `shrink-0`, so the title block is the only thing that can give — it is the
+          only flexible child. Measured with both of these forced visible: the title
+          collapses to 69px at 393px (an iPhone 15 Pro, a typical phone width) and
+          51px at 375px. "agent mesh" needs about 80px, so it truncates.
+          It never overflows, which is why `scrollWidth - clientWidth` reads 0 and looks
+          fine: flex takes the space out of the title instead. Measure the TITLE WIDTH,
+          not the header's overflow, if you touch this.
+          New and Chats keep their labels because they are the primary actions; refresh
+          and the theme toggle are conveniences and give up their room first. The theme
+          toggle therefore does not exist below 420px, so it also lives in the Chats
+          sheet — see ChatSwitcher. */}
+      <button aria-label="Refresh" className="hidden size-9 shrink-0 place-items-center rounded-full active:bg-accent min-[380px]:grid" onClick={args.onRefresh} type="button">
+        <RefreshCw className="size-4.5" />
+      </button>
+      <button aria-label="Toggle theme" className="hidden size-9 shrink-0 place-items-center rounded-full active:bg-accent min-[420px]:grid" onClick={args.onToggleTheme} type="button">
+        {args.theme === "dark" ? <Sun className="size-4.5" /> : <Moon className="size-4.5" />}
+      </button>
+    </header>
+  )
+}
