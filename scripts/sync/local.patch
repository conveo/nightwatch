@@ -0,0 +1,95 @@
+// The first thing the operator sees after a night away.
+//
+// Counted facts only — how many messages, from whom, which of them their own sender
+// marked as wanting a human, and which of the operator's questions are still open. No
+// summary is generated here on purpose: a model's opinion about forty messages is
+// something they would have to audit, and the whole point of this card is that they can
+// trust it at a glance. "Catch me up" is right there when they want the opinion, and
+// then it is a turn they asked for.
+
+import { ArrowUpRight, Bell, Clock, X } from "lucide-react"
+import { relTime } from "@/lib/format"
+import { cn } from "@/lib/utils"
+import type { Digest } from "./useDigest"
+
+export function WhileYouWereAway({ digest, onDismiss, onCatchMeUp }: { digest: Digest; onDismiss: () => void; onCatchMeUp: () => void }) {
+  const agents = digest.senders.length
+  return (
+    <div className="mb-2 w-full rounded-xl border border-border/70 bg-card/80 text-[13px]">
+      <div className="flex items-start gap-2 border-b border-border/60 px-3 py-2">
+        <Clock className="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
+        <p className="min-w-0 flex-1 leading-snug">
+          <span className="font-medium">While you were away</span>
+          <span className="text-muted-foreground">
+            {" · last "}
+            {relTime(digest.since)}
+          </span>
+        </p>
+        <button aria-label="Dismiss" className="-mr-1 -mt-1 grid size-7 shrink-0 place-items-center rounded-lg active:bg-accent" onClick={onDismiss} type="button">
+          <X className="size-3.5" />
+        </button>
+      </div>
+
+      <div className="flex flex-col gap-2 px-3 py-2.5">
+        <p className="leading-snug">
+          {digest.arrived === 0 ? (
+            "Nothing new arrived."
+          ) : (
+            <>
+              <span className="font-medium tabular">{digest.arrived}</span> message{digest.arrived === 1 ? "" : "s"} from{" "}
+              <span className="font-medium tabular">{agents}</span> agent{agents === 1 ? "" : "s"}.
+            </>
+          )}
+        </p>
+
+        {digest.needsYou.length > 0 && (
+          <div className="rounded-lg border border-primary/35 bg-primary/10 px-2.5 py-2">
+            <p className="flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-wide text-primary">
+              <Bell className="size-3" /> needs you · {digest.needsYou.length}
+            </p>
+            <ul className="mt-1 flex flex-col gap-1.5">
+              {digest.needsYou.slice(0, 4).map((n) => (
+                <li className="min-w-0 leading-snug" key={`${n.from}-${n.at}`}>
+                  {/* Truncated: mesh ids run to sixty characters and wrapping one costs
+                      two lines of a card whose whole job is to be read in one glance. */}
+                  <span className="block truncate font-mono text-[11.5px] text-muted-foreground">{n.from}</span>
+                  <span className="block text-foreground/85">{n.text}</span>
+                </li>
+              ))}
+            </ul>
+            {digest.needsYou.length > 4 && <p className="mt-1 text-[11px] text-muted-foreground">+{digest.needsYou.length - 4} more below.</p>}
+          </div>
+        )}
+
+        {digest.answered.length > 0 && (
+          <p className="leading-snug text-muted-foreground">
+            <span className="tabular text-status-online">{digest.answered.length}</span> of your questions came back.
+          </p>
+        )}
+
+        {digest.waiting.length > 0 && (
+          <div>
+            <p className="text-[11px] uppercase tracking-wide text-muted-foreground/80">Still waiting on</p>
+            <ul className="mt-0.5 flex flex-col gap-0.5">
+              {digest.waiting.slice(0, 3).map((w) => (
+                <li className="flex items-baseline gap-1.5 leading-snug" key={w.correlationId}>
+                  <span className="shrink-0 font-mono text-[11.5px] text-muted-foreground">{w.to}</span>
+                  <span className="min-w-0 flex-1 truncate text-foreground/75">{w.asked}</span>
+                  <span className="shrink-0 tabular text-[11px] text-muted-foreground/70">{relTime(w.askedAt)}</span>
+                </li>
+              ))}
+            </ul>
+          </div>
+        )}
+
+        <button
+          className={cn("flex items-center gap-1.5 self-start rounded-full bg-primary/15 px-3 py-1.5 text-[13px] font-medium text-primary active:bg-primary/25")}
+          onClick={onCatchMeUp}
+          type="button"
+        >
+          <ArrowUpRight className="size-3.5" /> Catch me up
+        </button>
+      </div>
+    </div>
+  )
+}
diff --git a/agent-mesh/dashboard/src/console/console-api.ts b/agent-mesh/dashboard/src/console/console-api.ts
new file mode 100644
index 0000000..805441d
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/console-api.ts
@@ -0,0 +1,114 @@
+// Typed client for the mobile console's /api/console/* routes.
+
+import type { MeshMessage } from "@/lib/api"
+
+export type ConsoleConfig = {
+  operatorId: string
+  hostname: string
+  chat: { available: boolean; model: string }
+  voice: { available: boolean; model: string; transcribeModel: string; voice: string }
+}
+
+export type ConversationSummary = {
+  id: string
+  lastId: string
+  lastTs: string
+  lastFrom: string
+  lastType: MeshMessage["type"]
+  preview: string
+  unreadFrom: number
+}
+
+export type ThreadResult = { peer: string; me: string; messages: MeshMessage[]; sendOnly: boolean }
+
+async function getJson<T>(path: string): Promise<T> {
+  const res = await fetch(path)
+  if (!res.ok) {
+    throw new Error(`${path} → ${res.status}: ${await res.text()}`)
+  }
+  return res.json() as Promise<T>
+}
+
+export const consoleApi = {
+  config: () => getJson<ConsoleConfig>("/api/console/config"),
+  conversations: (me: string) => getJson<{ me: string; peers: ConversationSummary[]; readCount: number | null }>(`/api/console/conversations?me=${encodeURIComponent(me)}`),
+  thread: (args: { peer: string; me: string }) =>
+    getJson<ThreadResult>(`/api/console/thread?peer=${encodeURIComponent(args.peer)}&me=${encodeURIComponent(args.me)}`),
+  // The voice session runs its tool loop in the browser; the implementations live
+  // on the server, so each call comes back through here.
+  runTool: async (name: string, input: unknown): Promise<unknown> => {
+    const res = await fetch("/api/console/mesh-tool", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ name, input }),
+    })
+    if (!res.ok) {
+      return { error: `tool '${name}' failed (${res.status})` }
+    }
+    const parsed = (await res.json()) as { output?: unknown }
+    return parsed.output ?? {}
+  },
+}
+
+/** Publish a mesh message as the operator. Used by the direct-thread composer. */
+export async function sendMeshMessage(args: {
+  me: string
+  to: string
+  type: MeshMessage["type"]
+  text: string
+  correlationId: string | null
+}): Promise<{ id: string; to: string }> {
+  const res = await fetch("/api/publish", {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({
+      from: args.me,
+      to: args.to,
+      type: args.type,
+      body: { text: args.text, via: "mobile-console" },
+      correlationId: args.correlationId,
+      replyTo: null,
+    }),
+  })
+  if (!res.ok) {
+    throw new Error(`publish → ${res.status}: ${await res.text()}`)
+  }
+  const parsed = (await res.json()) as { id?: string; to?: string; error?: unknown }
+  if (parsed.id == null) {
+    throw new Error(`publish rejected: ${JSON.stringify(parsed.error ?? parsed)}`)
+  }
+  return { id: parsed.id, to: parsed.to ?? args.to }
+}
+
+// ── id presentation ───────────────────────────────────────────────────────────
+// Agent ids are long and dotted (`acme.box.run1.orchestrator`,
+// `worktree-a1b2.laptop.c3d4e5f6`). On a 390px screen the leaf is the part that
+// identifies the agent, so it gets the weight and the scope is shown quieter.
+
+export function splitAgentId(id: string): { scope: string | null; leaf: string } {
+  const parts = id.split(".")
+  if (parts.length === 1) {
+    return { scope: null, leaf: id }
+  }
+  return { scope: parts.slice(0, -1).join("."), leaf: parts[parts.length - 1] }
+}
+
+/** Prefer the prose an agent actually wrote; mirrors the server's bodyToText. */
+const PROSE_KEYS = ["text", "msg", "message", "summary", "what", "question", "comment", "note", "status", "result"]
+
+export function bodyToText(body: Record<string, unknown>): string {
+  for (const key of PROSE_KEYS) {
+    const v = body[key]
+    if (typeof v === "string" && v.trim() !== "") {
+      return v.trim()
+    }
+  }
+  const parts: string[] = []
+  for (const [k, v] of Object.entries(body)) {
+    if (v === null || v === undefined) {
+      continue
+    }
+    parts.push(`**${k}** — ${typeof v === "object" ? `\`${JSON.stringify(v)}\`` : String(v)}`)
+  }
+  return parts.join("\n\n")
+}
diff --git a/agent-mesh/dashboard/src/console/transcript-client.ts b/agent-mesh/dashboard/src/console/transcript-client.ts
new file mode 100644
index 0000000..aaa2988
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/transcript-client.ts
@@ -0,0 +1,33 @@
+// The console's side of the durable transcript: reading, saving, and folding the
+// server copy into a surface's own.
+
+import type { UIMessage } from "ai"
+import { mergeTranscripts } from "../../../src/transcript-merge.ts"
+
+export function transcriptUrl(conversationId: string): string {
+  return `/api/console/transcript?conversation=${encodeURIComponent(conversationId)}`
+}
+
+/** A durable save, or null when it did not persist. `behind` is how many stored messages the save lacked. */
+export async function saveStored(args: { conversationId: string; messages: UIMessage[] }): Promise<{ behind: number } | null> {
+  try {
+    const r = await fetch(transcriptUrl(args.conversationId), {
+      method: "PUT",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ messages: args.messages }),
+    })
+    if (!r.ok) {
+      return null
+    }
+    const outcome = (await r.json()) as { saved: boolean; behind: number }
+    return outcome.saved ? outcome : null
+  } catch {
+    return null
+  }
+}
+
+/** This surface's messages folded into the server's, by the same merge the server saves with. */
+export function withStored(args: { stored: UIMessage[]; local: UIMessage[] }): UIMessage[] {
+  const row = (m: UIMessage) => ({ id: m.id, payload: m })
+  return mergeTranscripts({ stored: args.stored.map(row), incoming: args.local.map(row) }).rows.map((r) => r.payload)
+}
diff --git a/agent-mesh/dashboard/src/console/useArrivals.ts b/agent-mesh/dashboard/src/console/useArrivals.ts
new file mode 100644
index 0000000..5c56fd2
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/useArrivals.ts
@@ -0,0 +1,278 @@
+// Arrivals: one queue for the whole app session, owned by the shell.
+//
+// Not by the chat view. A view is one conversation and unmounts on every switch (and
+// on the phone, whenever a thread is open), so a view that handles arrivals misfiles
+// one whenever the operator moves mid-recap: the unmounting view finishes it into the chat they
+// just left, without its recap, while the view they open skips it as already handled.
+// The shell outlives every view, knows which chat is open NOW, and treats a view as
+// nothing more than a place to show an entry while it is on screen.
+
+import { readUIMessageStream, type UIMessage, type UIMessageChunk } from "ai"
+import { type MutableRefObject, useEffect, useRef } from "react"
+import type { MeshMessage } from "@/lib/api"
+import { bodyToText } from "./console-api"
+import { saveStored } from "./transcript-client"
+import { type InboxArrival, reportClientEvent } from "./useInboxStream"
+import type { PendingAsk } from "./usePendingAsks"
+
+/** The chat view on screen, offering to show arrivals that belong to its conversation. */
+export type ArrivalSink = {
+  conversationId: string
+  /** Put the entry in the thread, replacing an earlier version of it by id. */
+  show: (entry: UIMessage) => void
+  recent: () => UIMessage[]
+  pending: () => PendingAsk[]
+}
+
+/**
+ * Present every arrival, in order, and store each in the conversation that owns it.
+ *
+ * Returns the ref a chat view registers itself in. Groups run strictly one after
+ * another on one chain that is never cancelled: two recaps streaming at once would
+ * interleave, and a later arrival must not abandon the rest of an earlier batch whose
+ * ids the inbox has already recorded as delivered.
+ */
+export function useArrivals(args: { arrival: InboxArrival | null; activeConversation: string; onSaved: () => void }): MutableRefObject<ArrivalSink | null> {
+  const sinkRef = useRef<ArrivalSink | null>(null)
+  // Read at each step, not captured: which chat is open, and how to tell the switcher
+  // one was written to, are both whatever they are at the moment they are needed.
+  const activeRef = useRef(args.activeConversation)
+  activeRef.current = args.activeConversation
+  const onSavedRef = useRef(args.onSaved)
+  onSavedRef.current = args.onSaved
+  const handled = useRef(new Set<number>())
+  const queue = useRef<Promise<void>>(Promise.resolve())
+
+  const { arrival } = args
+  useEffect(() => {
+    if (arrival == null || handled.current.has(arrival.at)) {
+      return
+    }
+    handled.current.add(arrival.at)
+    for (const group of groupArrivals(arrival.messages)) {
+      queue.current = queue.current.then(() => present({ group, sinkRef, active: () => activeRef.current, onSaved: () => onSavedRef.current() }))
+    }
+  }, [arrival])
+
+  return sinkRef
+}
+
+/**
+ * One group, one timeline entry — shown if its chat is on screen, stored either way.
+ *
+ * The entry is created carrying the raw messages, so nothing is lost if the recap never
+ * arrives, and the recap then replaces its text as the readable layer. Two stacked
+ * items (a turn plus a comment on it) would double the length of the timeline.
+ */
+async function present(args: { group: MeshMessage[]; sinkRef: MutableRefObject<ArrivalSink | null>; active: () => string; onSaved: () => void }): Promise<void> {
+  const { group } = args
+  const entry = toMeshEntry(`mesh:${group[0].id}`, group)
+  // No known owner: news, filed where the operator is looking when it arrives.
+  const owner = (await arrivalOwner(group)) ?? args.active()
+  // Re-read at every step, since they can switch chats mid-recap: the entry keeps
+  // streaming into the owner's view if it is on screen, and stops showing if not.
+  const view = (): ArrivalSink | null => {
+    const sink = args.sinkRef.current
+    return sink?.conversationId === owner ? sink : null
+  }
+  const store = async (message: UIMessage) => {
+    // Stored in the conversation that owns it, whether or not it is on screen: by now
+    // the inbox has advanced past it and this browser has marked it seen, so for a
+    // chat that is not open this write is the ONLY place it lands. The server merges
+    // by id, so a one-entry save is an append — or, for the recap, an update in place.
+    if ((await saveStored({ conversationId: owner, messages: [message] })) != null) {
+      args.onSaved()
+    }
+  }
+
+  view()?.show(entry)
+  // Before the recap starts, so the raw can never land after — and overwrite — it.
+  await store(entry)
+
+  const context = view()
+  let final = entry
+  await narrate({
+    arriving: group,
+    recent: context?.recent() ?? [],
+    pending: context?.pending() ?? [],
+    onSnapshot: (m) => {
+      // Text only, and WITHOUT providerMetadata. Those ids are OpenAI's claim about its
+      // own conversation state; stored in the transcript they get replayed into a later
+      // request whose lineage never had them, and the provider rejects the whole call.
+      // A recap is a rendering artifact, not a resumable model item.
+      const recap = m.parts.filter((part) => part.type === "text").map((part) => ({ type: "text" as const, text: part.text }))
+      if (recap.length === 0) {
+        return
+      }
+      final = { ...entry, parts: recap }
+      view()?.show(final)
+    },
+  })
+  // Recapped off screen, too: an arrival for a chat the operator is not in still reads as a
+  // sentence when they open it, not as a raw envelope.
+  if (final !== entry) {
+    await store(final)
+  }
+}
+
+/**
+ * Run one narration turn for a batch of arrivals and stream it into the conversation.
+ *
+ * `readUIMessageStream` yields the same message object repeatedly as it fills in, so
+ * the caller replaces by id rather than appending — appending would stack one copy
+ * per token.
+ */
+async function narrate(args: {
+  arriving: MeshMessage[]
+  recent: UIMessage[]
+  pending: PendingAsk[]
+  onSnapshot: (message: UIMessage) => void
+}): Promise<void> {
+  try {
+    const res = await fetch("/api/console/narrate", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        messages: args.arriving,
+        // Enough for the assistant to know what the operator was doing; not so much that an
+        // unprompted turn costs as much as a real one.
+        recent: args.recent.slice(-6),
+        pending: args.pending,
+      }),
+    })
+    if (!res.ok || res.body == null) {
+      // Previously a bare return. A narration that fails must not inject an error
+      // bubble into a conversation the operator did not start — but it must not vanish without
+      // trace either, which is how one lost message cost a round of guessing.
+      reportClientEvent("narrate-failed", args.arriving.map((m) => m.id), `http ${res.status}`)
+      return
+    }
+    const stream = readUIMessageStream({
+      stream: res.body.pipeThrough(new TextDecoderStream()).pipeThrough(new JsonEventStream()),
+    })
+    for await (const message of stream) {
+      args.onSnapshot(message)
+    }
+    reportClientEvent("narrate-ok", args.arriving.map((m) => m.id))
+  } catch (e) {
+    // Still silent in the UI — an error bubble in a conversation the operator did not start is
+    // worse than none — but never silent in the log.
+    reportClientEvent("narrate-threw", args.arriving.map((m) => m.id), (e as Error).message)
+  }
+}
+
+/** Parse the `data:` payloads of an SSE body into the chunk objects the SDK expects. */
+class JsonEventStream extends TransformStream<string, UIMessageChunk> {
+  constructor() {
+    let buffer = ""
+    super({
+      transform(chunk, controller) {
+        buffer += chunk
+        const frames = buffer.split("\n\n")
+        buffer = frames.pop() ?? ""
+        for (const frame of frames) {
+          for (const line of frame.split("\n")) {
+            if (!line.startsWith("data: ")) {
+              continue
+            }
+            const payload = line.slice(6)
+            if (payload === "[DONE]") {
+              continue
+            }
+            try {
+              controller.enqueue(JSON.parse(payload) as UIMessageChunk)
+            } catch {
+              // a partial frame across a chunk boundary — the buffer picks it up
+            }
+          }
+        }
+      },
+    })
+  }
+}
+
+/**
+ * Which conversation an arrival belongs to, or null when it has no known owner.
+ *
+ * A reply belongs where the question was asked. Narrating a correlated answer into
+ * whatever chat happens to be open is wrong exactly when it matters — the answer
+ * arrives without its question. Uncorrelated mail, and a correlation this console
+ * never asked, have no owner: they are news, shown where the operator is looking.
+ */
+async function arrivalOwner(arriving: MeshMessage[]): Promise<string | null> {
+  const correlated = arriving.find((m) => m.correlationId != null && m.correlationId !== "")
+  if (correlated?.correlationId == null) {
+    return null
+  }
+  try {
+    const res = await fetch(`/api/console/arrival-owner?correlationId=${encodeURIComponent(correlated.correlationId)}`)
+    if (!res.ok) {
+      return null
+    }
+    const { conversationId } = (await res.json()) as { conversationId: string | null }
+    return conversationId
+  } catch {
+    return null
+  }
+}
+
+/**
+ * Split one arrival window into the things it actually contains.
+ *
+ * The batching window is 1.2 seconds, which is a statement about typing latency, not
+ * about meaning. Three messages from one agent answering one request ARE one thing and
+ * collapse cleanly. Two agents answering two different questions inside the same
+ * second are two things, and folding them under a single recap would invent a
+ * relationship between them — at exactly the moment the operator is scanning fastest, first
+ * thing in the morning. The whole model is that an answer is tied to its question, so
+ * the group key is the sender and the correlation, never the clock.
+ *
+ * Messages with no correlation id are grouped per sender rather than lumped together:
+ * uncorrelated mail from two agents is still two pieces of news.
+ */
+function groupArrivals(messages: MeshMessage[]): MeshMessage[][] {
+  const groups = new Map<string, MeshMessage[]>()
+  for (const m of messages) {
+    const key = `${m.from}\u0000${m.correlationId ?? ""}`
+    const existing = groups.get(key)
+    if (existing == null) {
+      groups.set(key, [m])
+      continue
+    }
+    existing.push(m)
+  }
+  return [...groups.values()]
+}
+
+/**
+ * One arrival, one timeline entry.
+ *
+ * Collapsed by default: the assistant's recap is what the operator reads, the raw messages sit
+ * behind an expandable affordance with their author, type and time. Both live in the
+ * SAME entry — a recap and a payload occupying separate slots would double the length
+ * of the timeline and make the readability problem worse while technically satisfying
+ * "show me the reply".
+ *
+ * The raw is attached at creation, before the recap exists, so an arrival is never
+ * lost to a failed narration — worst case the entry shows its raw and no summary.
+ *
+ * The mesh stream id IS the entry id, so a replay or re-render cannot produce two
+ * copies of the same reply.
+ */
+function toMeshEntry(entryId: string, messages: MeshMessage[]): UIMessage {
+  const raw = messages.map((m) => ({ id: m.id, author: m.from, type: m.type, at: m.ts, correlationId: m.correlationId, text: bodyToText(m.body) }))
+  return {
+    id: entryId,
+    role: "assistant",
+    metadata: {
+      author: messages[0].from,
+      correlationId: messages[0].correlationId,
+      meshType: messages[0].type,
+      at: messages[0].ts,
+      raw,
+    },
+    // Until the recap streams in, the entry shows the message itself rather than a
+    // placeholder — a spinner that never resolves would be worse than the raw text.
+    parts: [{ type: "text", text: raw.map((r) => r.text).join("\n\n") }],
+  } as UIMessage
+}
diff --git a/agent-mesh/dashboard/src/console/useConsoleData.ts b/agent-mesh/dashboard/src/console/useConsoleData.ts
new file mode 100644
index 0000000..1972b9d
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/useConsoleData.ts
@@ -0,0 +1,86 @@
+// The data the console needs at either width: who the operator is on the mesh, the live
+// roster, and the conversations they already have. Shared by the phone shell and the
+// desktop tab so the two cannot drift on polling, identity, or unread counts.
+
+import { useCallback, useEffect, useState } from "react"
+import { api, type AgentRecord } from "@/lib/api"
+import { usePersistedState } from "@/lib/usePersistedState"
+import { consoleApi, type ConsoleConfig, type ConversationSummary } from "./console-api"
+
+// The roster and the conversation list are cheap reads off a local unix socket. Both
+// pause while the tab is hidden so a phone in a pocket — or a monitor the operator walked
+// away from — is not polling a dev box all afternoon.
+const ROSTER_MS = 5000
+
+export type ConsoleData = {
+  config: ConsoleConfig | null
+  configError: string | null
+  me: string
+  agents: AgentRecord[]
+  peers: ConversationSummary[]
+  unread: number
+  online: number
+  sentTo: string[]
+  rememberSent: (peer: string) => void
+  refresh: () => void
+}
+
+export function useConsoleData(): ConsoleData {
+  const [config, setConfig] = useState<ConsoleConfig | null>(null)
+  const [configError, setConfigError] = useState<string | null>(null)
+  const [agents, setAgents] = useState<AgentRecord[]>([])
+  const [peers, setPeers] = useState<ConversationSummary[]>([])
+  // Agents the operator has written to from this browser. The server cannot know these: a mesh
+  // message lands only in the recipient's stream, so a thread they started but that has
+  // never answered leaves no trace in their own inbox.
+  // Key name predates the desktop console; kept as-is so an existing phone's list
+  // survives rather than being silently reset for a tidier string.
+  const [sentTo, setSentTo] = usePersistedState<string[]>("mobile-sent-to", [])
+
+  useEffect(() => {
+    consoleApi.config().then(setConfig, (e: Error) => setConfigError(e.message))
+  }, [])
+
+  const me = config?.operatorId ?? "operator"
+
+  const refresh = useCallback(() => {
+    void api.agents().then(setAgents, () => undefined)
+    void consoleApi.conversations(me).then((r) => setPeers(r.peers), () => undefined)
+  }, [me])
+
+  useEffect(() => {
+    if (config == null) {
+      return
+    }
+    refresh()
+    const onVisible = () => {
+      if (document.visibilityState === "visible") {
+        refresh()
+      }
+    }
+    const t = setInterval(onVisible, ROSTER_MS)
+    document.addEventListener("visibilitychange", onVisible)
+    return () => {
+      clearInterval(t)
+      document.removeEventListener("visibilitychange", onVisible)
+    }
+  }, [config, refresh])
+
+  const rememberSent = useCallback(
+    (peer: string) => setSentTo((prev) => (prev.includes(peer) ? prev : [peer, ...prev].slice(0, 40))),
+    [setSentTo],
+  )
+
+  return {
+    config,
+    configError,
+    me,
+    agents,
+    peers,
+    unread: peers.reduce((n, p) => n + p.unreadFrom, 0),
+    online: agents.filter((a) => a.status === "online").length,
+    sentTo,
+    rememberSent,
+    refresh,
+  }
+}
diff --git a/agent-mesh/dashboard/src/console/useConversations.ts b/agent-mesh/dashboard/src/console/useConversations.ts
new file mode 100644
index 0000000..f3b4e90
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/useConversations.ts
@@ -0,0 +1,62 @@
+// Which chat is open, and what other chats exist.
+//
+// The id lives in localStorage so returning from a notification lands back in the
+// conversation the operator was in, not always in the first one. The LIST comes from the server,
+// because that is the copy that survives a cleared browser and a second device.
+
+import { useCallback, useEffect, useState } from "react"
+
+export type ConversationSummary = { id: string; title: string; messages: number; updatedAt: string }
+
+const ACTIVE_KEY = "agent-mesh:console-active-conversation"
+export const DEFAULT_CONVERSATION = "default"
+
+function loadActive(): string {
+  try {
+    return localStorage.getItem(ACTIVE_KEY) ?? DEFAULT_CONVERSATION
+  } catch {
+    return DEFAULT_CONVERSATION
+  }
+}
+
+export function useConversations(): {
+  active: string
+  list: ConversationSummary[]
+  select: (id: string) => void
+  create: () => string
+  refresh: () => void
+} {
+  const [active, setActive] = useState<string>(loadActive)
+  const [list, setList] = useState<ConversationSummary[]>([])
+
+  const refresh = useCallback(() => {
+    void fetch("/api/console/conversations-list")
+      .then((r) => (r.ok ? r.json() : null))
+      .then((d: { conversations?: ConversationSummary[] } | null) => setList(d?.conversations ?? []))
+      .catch(() => undefined)
+  }, [])
+
+  useEffect(() => {
+    refresh()
+  }, [refresh])
+
+  const select = useCallback((id: string) => {
+    setActive(id)
+    try {
+      localStorage.setItem(ACTIVE_KEY, id)
+    } catch {
+      /* private mode — the choice just does not survive a reload */
+    }
+  }, [])
+
+  const create = useCallback(() => {
+    // Created client-side and only persisted once it has a message: an id alone is not
+    // a conversation, and a "New chat" row that appears in the list before the operator has said
+    // anything is clutter they then have to clean up.
+    const id = `c-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 6)}`
+    select(id)
+    return id
+  }, [select])
+
+  return { active, list, select, create, refresh }
+}
diff --git a/agent-mesh/dashboard/src/console/useDigest.ts b/agent-mesh/dashboard/src/console/useDigest.ts
new file mode 100644
index 0000000..c8f2ac1
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/useDigest.ts
@@ -0,0 +1,115 @@
+// "While you were away", and the one piece of state it needs: when this browser last
+// had the console on screen.
+//
+// Per-surface on purpose. The server cannot answer "when did YOU last look" — the
+// phone and the laptop are away at different times, and a server-side last-seen would
+// mean opening the laptop erased the phone's morning digest.
+
+import { useEffect, useRef, useState } from "react"
+
+export type DigestAsk = { correlationId: string; to: string; asked: string; askedAt: string; answeredAt: string | null }
+
+export type Digest = {
+  since: string
+  arrived: number
+  senders: { id: string; count: number; lastAt: string; lastType: string }[]
+  needsYou: { from: string; at: string; type: string; correlationId: string | null; text: string }[]
+  answered: DigestAsk[]
+  waiting: DigestAsk[]
+}
+
+const LAST_SEEN_KEY = "agent-mesh:console-last-seen"
+// Below this it was a tab switch, a phone call, a lock screen — not an absence. A
+// digest that appears every time the operator glances away is chrome, and they stop reading it,
+// which costs the one morning it was built for.
+const AWAY_MS = 45 * 60 * 1000
+// How often the mark is refreshed while they are watching. Frequent enough that a crash
+// or a force-quit does not make the next open look like an absence.
+const MARK_MS = 60 * 1000
+
+function readLastSeen(): number | null {
+  try {
+    const raw = localStorage.getItem(LAST_SEEN_KEY)
+    const n = raw != null ? Number.parseInt(raw, 10) : Number.NaN
+    return Number.isFinite(n) ? n : null
+  } catch {
+    return null
+  }
+}
+
+function markSeen(): void {
+  try {
+    localStorage.setItem(LAST_SEEN_KEY, String(Date.now()))
+  } catch {
+    /* private mode — the digest just never triggers, which is the safe direction */
+  }
+}
+
+// Captured at MODULE LOAD, which is once per page load, before any component mounts.
+// A ref inside the hook is not enough: the console remounts (a view change, a
+// conversation switch), and by the second mount the first mount's effect has already
+// written a fresh mark — so the absence measures itself against a timestamp this very
+// page wrote, and the digest never appears. That failure is silent and only shows up
+// on the morning it was built for.
+const AWAY_SINCE = readLastSeen()
+
+export function useDigest(conversationId: string): { digest: Digest | null; dismiss: () => void } {
+  const [digest, setDigest] = useState<Digest | null>(null)
+  const awaySince = useRef<number | null>(AWAY_SINCE)
+
+  useEffect(() => {
+    markSeen()
+    const t = setInterval(() => {
+      if (document.visibilityState === "visible") {
+        markSeen()
+      }
+    }, MARK_MS)
+    // Also on the way out, so a deliberate close records a fresh mark rather than
+    // leaving up to a minute of drift that reads as extra absence.
+    const onHide = () => {
+      if (document.visibilityState === "hidden") {
+        markSeen()
+      }
+    }
+    document.addEventListener("visibilitychange", onHide)
+    return () => {
+      clearInterval(t)
+      document.removeEventListener("visibilitychange", onHide)
+    }
+  }, [])
+
+  useEffect(() => {
+    const since = awaySince.current
+    // A recent mark means they never left — a tab switch, not an absence.
+    if (since != null && Date.now() - since < AWAY_MS) {
+      return
+    }
+    // No mark at all is NOT a reason to skip: a browser that was just updated, or a
+    // second device, has none — and that is precisely the first open where a digest is
+    // worth most. `since` is omitted and the server falls back to when the conversation
+    // was last written, answering the same question from the side it can see. A console
+    // that has never been used anywhere gets an empty digest and nothing renders.
+    const sinceParam = since != null ? `since=${encodeURIComponent(new Date(since).toISOString())}&` : ""
+    let live = true
+    void fetch(`/api/console/digest?${sinceParam}conversation=${encodeURIComponent(conversationId)}`)
+      .then((r) => (r.ok ? r.json() : null))
+      .then((d: Digest | null) => {
+        if (!live || d == null) {
+          return
+        }
+        // Nothing arrived and nothing is outstanding: they missed nothing, so say
+        // nothing. An empty digest card is worse than no card — it makes the absence
+        // itself the news.
+        if (d.arrived === 0 && d.waiting.length === 0) {
+          return
+        }
+        setDigest(d)
+      })
+      .catch(() => undefined)
+    return () => {
+      live = false
+    }
+  }, [conversationId])
+
+  return { digest, dismiss: () => setDigest(null) }
+}
diff --git a/agent-mesh/dashboard/src/console/useInboxStream.ts b/agent-mesh/dashboard/src/console/useInboxStream.ts
new file mode 100644
index 0000000..69798d6
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/useInboxStream.ts
@@ -0,0 +1,145 @@
+// Subscribe once, at the shell, to everything arriving in the operator's mesh inbox.
+//
+// Mounted by the shell rather than by a view: a per-view subscription would open a
+// second stream every time they switched tabs, and would go deaf the moment they were
+// looking at something else — which is exactly when an answer is most likely to land.
+
+import { useEffect, useRef, useState } from "react"
+import type { MeshMessage } from "@/lib/api"
+
+export type InboxArrival = { messages: MeshMessage[]; at: number }
+
+// A burst of related messages should become ONE narration, not four in a row. The
+// window is short enough that a single message still feels immediate.
+const BATCH_MS = 1200
+// Comfortably inside the server's 45s presence window, so one dropped beacon does not
+// make a watching console look absent.
+const PRESENCE_MS = 15_000
+
+export function useInboxStream(): { arrival: InboxArrival | null; connected: boolean } {
+  const [arrival, setArrival] = useState<InboxArrival | null>(null)
+  const [connected, setConnected] = useState(false)
+  // Messages seen but not yet released, and the ids already released. Dedup is by
+  // channel+id per the delivery contract — notification count is not identity.
+  //
+  // The released set is PERSISTED. In memory alone it survives an EventSource
+  // auto-reconnect but not a reload, and iOS Safari discards background tabs hard
+  // enough that returning to the console is a reload far more often than on desktop.
+  // If the server ever does hand a new connection a backlog, an unpersisted set turns
+  // that into a narration of things they have already read — old news presented as new,
+  // which is worse than silence.
+  const pending = useRef<MeshMessage[]>([])
+  const seen = useRef<Set<string>>(loadSeen())
+  const timer = useRef<ReturnType<typeof setTimeout> | null>(null)
+
+  // Presence beacon: only while the tab is actually on screen. This is what decides
+  // whether an arrival narrates quietly or buzzes their phone, so it must mean "they are
+  // looking", not "a socket exists" — a backgrounded tab holds a socket open and is
+  // exactly when a notification IS wanted.
+  useEffect(() => {
+    const beat = () => {
+      if (document.visibilityState !== "visible") {
+        return
+      }
+      void fetch("/api/console/presence", { method: "POST", keepalive: true, headers: { "Content-Type": "application/json" }, body: "{}" }).catch(() => undefined)
+    }
+    beat()
+    const t = setInterval(beat, PRESENCE_MS)
+    document.addEventListener("visibilitychange", beat)
+    return () => {
+      clearInterval(t)
+      document.removeEventListener("visibilitychange", beat)
+    }
+  }, [])
+
+  useEffect(() => {
+    const es = new EventSource("/api/console/events")
+    es.addEventListener("ready", () => setConnected(true))
+    es.addEventListener("inbox", (e) => {
+      let parsed: { messages?: MeshMessage[] }
+      try {
+        parsed = JSON.parse((e as MessageEvent<string>).data) as { messages?: MeshMessage[] }
+      } catch {
+        return
+      }
+      const incoming = parsed.messages ?? []
+      const fresh = incoming.filter((m) => {
+        const key = `${m.channel}:${m.id}`
+        if (seen.current.has(key)) {
+          return false
+        }
+        seen.current.add(key)
+        return true
+      })
+      saveSeen(seen.current)
+      // A drop is a DECISION and it has to be visible. The released-id set is now
+      // persisted, so a bug here would suppress a message permanently across reloads —
+      // the failure would look exactly like the mesh never delivering it.
+      if (fresh.length < incoming.length) {
+        reportClientEvent("dropped-as-seen", incoming.filter((m) => !fresh.includes(m)).map((m) => m.id))
+      }
+      if (fresh.length === 0) {
+        return
+      }
+      pending.current = [...pending.current, ...fresh]
+      if (timer.current != null) {
+        clearTimeout(timer.current)
+      }
+      timer.current = setTimeout(() => {
+        const batch = pending.current
+        pending.current = []
+        timer.current = null
+        if (batch.length > 0) {
+          setArrival({ messages: batch, at: Date.now() })
+        }
+      }, BATCH_MS)
+    })
+    // EventSource reconnects on its own; the flag just stops the UI claiming a live
+    // feed while the server is down.
+    es.onerror = () => setConnected(false)
+    return () => {
+      es.close()
+      if (timer.current != null) {
+        clearTimeout(timer.current)
+      }
+    }
+  }, [])
+
+  return { arrival, connected }
+}
+
+// Bounded so the key cannot grow without limit on a console that runs for weeks;
+// only the most recent ids can plausibly be replayed to a reconnecting client.
+const SEEN_KEY = "agent-mesh:console-seen"
+const SEEN_CAP = 300
+
+function loadSeen(): Set<string> {
+  try {
+    const raw = localStorage.getItem(SEEN_KEY)
+    return new Set(raw != null ? (JSON.parse(raw) as string[]) : [])
+  } catch {
+    return new Set() // private mode / cleared storage — degrade, never throw
+  }
+}
+
+function saveSeen(seen: Set<string>): void {
+  try {
+    localStorage.setItem(SEEN_KEY, JSON.stringify([...seen].slice(-SEEN_CAP)))
+  } catch {
+    /* quota or private mode — dedup falls back to per-session, which still works */
+  }
+}
+
+/**
+ * Tell the server what the browser decided. The server can log what IT did; only the
+ * client knows what it chose to drop, so without this "never narrated" and "narrated
+ * and failed" are indistinguishable in the log. Ids and reasons only — never bodies.
+ */
+export function reportClientEvent(event: string, ids: string[], detail?: string): void {
+  void fetch("/api/console/client-event", {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    keepalive: true,
+    body: JSON.stringify({ event, ids, detail: detail ?? null }),
+  }).catch(() => undefined)
+}
diff --git a/agent-mesh/dashboard/src/console/usePendingAsks.ts b/agent-mesh/dashboard/src/console/usePendingAsks.ts
new file mode 100644
index 0000000..12d66cb
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/usePendingAsks.ts
@@ -0,0 +1,82 @@
+// What the operator is currently waiting on.
+//
+// Derived from the conversation rather than stored alongside it: every ask is already
+// recorded in the transcript as a completed `send_message` tool call carrying its
+// correlationId, so a second source of truth could only drift. When an inbound reply
+// carries one of these correlation ids, the narration turn is told what the original
+// question was and how long ago — which is what turns "check again" from a habit into
+// something they never have to think about.
+
+import type { UIMessage } from "ai"
+import { useMemo } from "react"
+
+export type PendingAsk = {
+  correlationId: string
+  to: string
+  asked: string
+  askedAt: string
+  askedAtMs: number
+}
+
+// Past this an unanswered ask stops being "pending" and becomes history. Agents that
+// are going to answer answer within minutes; keeping a two-hour-old question on the
+// waiting list would make every later arrival look like a resolution.
+const STALE_MS = 30 * 60 * 1000
+
+export function usePendingAsks(messages: UIMessage[]): PendingAsk[] {
+  return useMemo(() => {
+    const asks = new Map<string, PendingAsk>()
+    for (const m of messages) {
+      for (const part of m.parts) {
+        if (part.type !== "tool-send_message") {
+          continue
+        }
+        const p = part as {
+          state?: string
+          input?: { to?: unknown; text?: unknown; correlationId?: unknown }
+          output?: { sent?: unknown; correlationId?: unknown; at?: unknown }
+        }
+        if (p.state !== "output-available" || p.output?.sent !== true) {
+          continue
+        }
+        // Prefer the id the SERVER used: it mints one when the model left the field
+        // empty, so the output is the only place the real value is guaranteed.
+        const corr =
+          typeof p.output?.correlationId === "string" && p.output.correlationId.trim() !== ""
+            ? p.output.correlationId.trim()
+            : typeof p.input?.correlationId === "string"
+              ? p.input.correlationId.trim()
+              : ""
+        const to = typeof p.input?.to === "string" ? p.input.to : ""
+        const text = typeof p.input?.text === "string" ? p.input.text : ""
+        // Only a correlated ask can be resolved by an incoming reply; an uncorrelated
+        // send is fire-and-forget and claiming otherwise would be a lie in the UI.
+        if (corr === "" || to === "") {
+          continue
+        }
+        // The mesh's own send time, not now(). A UIMessage has no timestamp, so before
+        // the tool started returning `at` this read Date.now() at RENDER — which made
+        // every ask permanently zero minutes old, so nothing ever aged out of the
+        // pending list and "asked 4 minutes ago" was never true. Transcripts written
+        // before that fall back to now and simply age from when they were first seen.
+        const sentAt = typeof p.output?.at === "string" ? Date.parse(p.output.at) : Number.NaN
+        const at = Number.isFinite(sentAt) ? sentAt : Date.now()
+        asks.set(corr, {
+          correlationId: corr,
+          to,
+          asked: text.slice(0, 300),
+          askedAt: new Date(at).toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" }),
+          askedAtMs: at,
+        })
+      }
+    }
+    const now = Date.now()
+    return [...asks.values()].filter((a) => now - a.askedAtMs < STALE_MS)
+  }, [messages])
+}
+
+/** Correlation ids among `arriving` that resolve something the operator asked. */
+export function resolvedBy(arriving: Array<{ correlationId: string | null }>, pending: PendingAsk[]): PendingAsk[] {
+  const ids = new Set(arriving.map((m) => m.correlationId).filter((c): c is string => c != null && c !== ""))
+  return pending.filter((p) => ids.has(p.correlationId))
+}
diff --git a/agent-mesh/dashboard/src/console/usePushOptIn.ts b/agent-mesh/dashboard/src/console/usePushOptIn.ts
new file mode 100644
index 0000000..ea71364
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/usePushOptIn.ts
@@ -0,0 +1,160 @@
+// Opting a device in to push notifications.
+//
+// ── Why this is not just Notification.requestPermission() ────────────────────
+// On iOS, Safari grants Push ONLY to a site installed to the Home Screen. In a tab,
+// `PushManager` is often absent entirely, and where it exists the permission request
+// resolves to "denied" without ever showing a prompt. Asking anyway would burn the
+// one prompt the browser gives you and leave you certain the feature is broken.
+//
+// So the hook reports WHY it cannot subscribe, and the UI tells you the one manual
+// step only you can do: Share → Add to Home Screen, then open it from there.
+
+import { useCallback, useEffect, useState } from "react"
+
+export type PushState =
+  | { kind: "unsupported"; reason: string }
+  | { kind: "needs-install"; reason: string }
+  | { kind: "blocked" }
+  | { kind: "available"; devices: number }
+  | { kind: "subscribed"; devices: number }
+  /** This browser holds a subscription the SERVER no longer has. See `refresh`. */
+  | { kind: "stale"; devices: number }
+
+// iOS reports standalone through a non-standard property on navigator.
+function isStandalone(): boolean {
+  return window.matchMedia("(display-mode: standalone)").matches || (navigator as { standalone?: boolean }).standalone === true
+}
+
+function isIos(): boolean {
+  return /iPad|iPhone|iPod/.test(navigator.userAgent)
+}
+
+export function usePushOptIn(): { state: PushState; enable: () => Promise<void>; disable: () => Promise<void>; busy: boolean } {
+  const [state, setState] = useState<PushState>({ kind: "unsupported", reason: "checking…" })
+  const [busy, setBusy] = useState(false)
+
+  const refresh = useCallback(async () => {
+    if (!("serviceWorker" in navigator) || typeof window.PushManager === "undefined") {
+      setState({
+        kind: isIos() && !isStandalone() ? "needs-install" : "unsupported",
+        reason: isIos() ? "iOS only allows notifications once the console is added to your Home Screen." : "This browser has no Push support.",
+      })
+      return
+    }
+    if (isIos() && !isStandalone()) {
+      setState({ kind: "needs-install", reason: "iOS only allows notifications once the console is added to your Home Screen." })
+      return
+    }
+    if (Notification.permission === "denied") {
+      setState({ kind: "blocked" })
+      return
+    }
+    try {
+      const reg = await navigator.serviceWorker.getRegistration()
+      const existing = await reg?.pushManager.getSubscription()
+      // Ask about THIS endpoint, not just how many devices exist. A push service
+      // invalidates an endpoint unilaterally (the app was removed, the browser rotated
+      // it, it expired) and the server prunes it on the 404/410 — but the browser keeps
+      // handing out the same dead subscription object forever. Reporting "subscribed"
+      // from the browser copy alone is how push dies quietly: the toggle stays on, the
+      // phone stays silent, and nothing anywhere says so.
+      const query = existing != null ? `?endpoint=${encodeURIComponent(existing.endpoint)}` : ""
+      const cfg = (await (await fetch(`/api/console/push${query}`)).json()) as { devices?: number; registered?: boolean | null }
+      if (existing == null) {
+        setState({ kind: "available", devices: cfg.devices ?? 0 })
+        return
+      }
+      setState(cfg.registered === false ? { kind: "stale", devices: cfg.devices ?? 0 } : { kind: "subscribed", devices: cfg.devices ?? 0 })
+    } catch {
+      setState({ kind: "unsupported", reason: "Could not read the push configuration from the server." })
+    }
+  }, [])
+
+  useEffect(() => {
+    void refresh()
+    // Re-check when they come back to the console. A subscription is pruned by a send
+    // that happens while the tab is closed, so the mount-time answer can be hours stale
+    // by the time they look — and "it broke while you were away" is precisely the case
+    // this state exists to report.
+    const recheck = () => {
+      if (document.visibilityState === "visible") {
+        void refresh()
+      }
+    }
+    document.addEventListener("visibilitychange", recheck)
+    return () => document.removeEventListener("visibilitychange", recheck)
+  }, [refresh])
+
+  const enable = useCallback(async () => {
+    setBusy(true)
+    try {
+      const reg = await navigator.serviceWorker.register("/sw.js", { scope: "/" })
+      await navigator.serviceWorker.ready
+      // Drop a dead subscription before asking for a new one. `subscribe()` on a
+      // registration that already has one returns THAT one — so re-enabling after a
+      // prune would hand the server back the very endpoint the push service rejected,
+      // and the toggle would flip to "on" having fixed nothing.
+      const stale = await reg.pushManager.getSubscription()
+      if (stale != null) {
+        await stale.unsubscribe().catch(() => undefined)
+      }
+      const permission = await Notification.requestPermission()
+      if (permission !== "granted") {
+        setState({ kind: "blocked" })
+        return
+      }
+      const { publicKey } = (await (await fetch("/api/console/push")).json()) as { publicKey: string }
+      const sub = await reg.pushManager.subscribe({
+        userVisibleOnly: true,
+        applicationServerKey: urlBase64ToUint8Array(publicKey),
+      })
+      await fetch("/api/console/push", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ subscription: sub.toJSON() }),
+      })
+      await refresh()
+    } catch {
+      setState({ kind: "unsupported", reason: "The browser refused the push subscription." })
+    } finally {
+      setBusy(false)
+    }
+  }, [refresh])
+
+  const disable = useCallback(async () => {
+    setBusy(true)
+    try {
+      const reg = await navigator.serviceWorker.getRegistration()
+      const sub = await reg?.pushManager.getSubscription()
+      if (sub != null) {
+        // Tell the server FIRST: if the local unsubscribe succeeds and the POST does
+        // not, the server keeps pushing to an endpoint that no longer exists.
+        await fetch("/api/console/push", {
+          method: "POST",
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify({ subscription: sub.toJSON(), unsubscribe: true }),
+        })
+        await sub.unsubscribe()
+      }
+      await refresh()
+    } finally {
+      setBusy(false)
+    }
+  }, [refresh])
+
+  return { state, enable, disable, busy }
+}
+
+// VAPID keys travel as base64url; PushManager wants raw bytes. The buffer is
+// allocated explicitly so the result is a Uint8Array<ArrayBuffer> — the DOM types
+// reject the SharedArrayBuffer-capable default.
+function urlBase64ToUint8Array(base64Url: string): Uint8Array<ArrayBuffer> {
+  const padding = "=".repeat((4 - (base64Url.length % 4)) % 4)
+  const base64 = (base64Url + padding).replace(/-/g, "+").replace(/_/g, "/")
+  const raw = atob(base64)
+  const out = new Uint8Array(new ArrayBuffer(raw.length))
+  for (let i = 0; i < raw.length; i++) {
+    out[i] = raw.charCodeAt(i)
+  }
+  return out
+}
diff --git a/agent-mesh/dashboard/src/console/useReceipt.ts b/agent-mesh/dashboard/src/console/useReceipt.ts
new file mode 100644
index 0000000..fc091c4
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/useReceipt.ts
@@ -0,0 +1,100 @@
+// What happened to a message the operator sent.
+//
+// The failure this exists for: an agent that is thinking and an agent that never got
+// the message look identical in a chat window. That ambiguity leaves the operator
+// waiting on a console they start to believe is broken.
+//
+// Every state here is one the mesh can actually prove. Where it cannot — an agent
+// served by another host keeps its read cursor on that host — the answer is "unknown",
+// never a cheerful default. A badge that guesses is worse than no badge: the first
+// time it says "read" about something that was not, they stop believing all of them.
+
+import { useEffect, useState } from "react"
+
+export type Receipt = {
+  delivered: boolean | null
+  deliveredReason: "found-in-inbox" | "inbox-unreadable" | "no-request-from-you"
+  read: boolean | null
+  readReason: "answered-it" | "read-cursor" | "cursor-not-visible"
+  readKnown: boolean
+  answered: boolean
+  answeredAt: string | null
+}
+
+// Slow on purpose. This is a reassurance signal, not a data feed — replies arrive over
+// the SSE stream and render themselves. One poll every 20s per unanswered ask is
+// enough to watch a status change while walking, and the ask list is capped by the
+// transcript, so the cost stays flat.
+const POLL_MS = 20_000
+// Past this an ask stops being something the operator is waiting on. Matches the pending-ask
+// window in usePendingAsks, so a card and the waiting list never disagree.
+const WATCH_MS = 30 * 60 * 1000
+
+export function useReceipt(args: { correlationId: string; to: string; sentAtMs: number | null }): Receipt | null {
+  const { correlationId, to, sentAtMs } = args
+  const [receipt, setReceipt] = useState<Receipt | null>(null)
+
+  useEffect(() => {
+    if (correlationId === "" || to === "") {
+      return
+    }
+    let live = true
+    let timer: ReturnType<typeof setTimeout> | null = null
+
+    const poll = async (): Promise<void> => {
+      try {
+        const res = await fetch(`/api/console/receipts?correlationId=${encodeURIComponent(correlationId)}&to=${encodeURIComponent(to)}`)
+        if (!res.ok || !live) {
+          return
+        }
+        const r = (await res.json()) as Receipt
+        if (!live) {
+          return
+        }
+        setReceipt(r)
+        // An answered ask is finished: nothing it reports can change again, so the
+        // poll stops rather than running for the rest of the session.
+        if (r.answered) {
+          return
+        }
+        // Stop watching an old ask on its own, rather than relying on the component
+        // unmounting. A phone left open on one conversation never unmounts anything.
+        if (sentAtMs != null && Date.now() - sentAtMs > WATCH_MS) {
+          return
+        }
+        timer = setTimeout(() => void poll(), POLL_MS)
+      } catch {
+        // A failed probe means unknown, which is what `receipt` already says. Retrying
+        // forever on a console whose server is down would just burn battery.
+      }
+    }
+
+    void poll()
+    return () => {
+      live = false
+      if (timer != null) {
+        clearTimeout(timer)
+      }
+    }
+  }, [correlationId, to, sentAtMs])
+
+  return receipt
+}
+
+/** One short phrase, and whether it is good news, bad news or an honest shrug. */
+export function receiptLabel(r: Receipt): { text: string; tone: "good" | "waiting" | "unknown" } {
+  if (r.answered) {
+    const at = r.answeredAt != null ? new Date(r.answeredAt).toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" }) : null
+    return { text: at != null ? `answered ${at}` : "answered", tone: "good" }
+  }
+  if (r.delivered !== true) {
+    return {
+      text: r.deliveredReason === "inbox-unreadable" ? "can't reach that inbox" : "no send record",
+      tone: "unknown",
+    }
+  }
+  if (!r.readKnown) {
+    return { text: "delivered · read unknown on that host", tone: "unknown" }
+  }
+  return r.read === true ? { text: "read, no reply yet", tone: "waiting" } : { text: "delivered, not read yet", tone: "waiting" }
+}
diff --git a/agent-mesh/dashboard/src/console/useVoiceController.ts b/agent-mesh/dashboard/src/console/useVoiceController.ts
new file mode 100644
index 0000000..eab11b5
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/useVoiceController.ts
@@ -0,0 +1,60 @@
+// Voice session ownership, shared by the phone shell and the desktop console.
+//
+// It lives above the views on purpose. The model uses `open_thread` to move the
+// screen mid-sentence, and on the phone that is a full navigation — a session owned
+// by the view the operator happened to be looking at when they started talking would be
+// torn down by the model's own tool call. Hoisting it also means one implementation
+// serves both widths instead of two that drift.
+
+import type { UIMessage } from "ai"
+import { useCallback, useRef, useState } from "react"
+
+export type VoiceController = {
+  /** Non-null while a session is wanted; the VoiceSession component renders off this. */
+  session: { stream: MediaStream; instructions: string } | null
+  messages: UIMessage[]
+  setMessages: (messages: UIMessage[]) => void
+  micError: string | null
+  start: (instructions: string) => void
+  stop: () => void
+  /**
+   * Set by whichever view owns the typed conversation. On stop, the spoken turns are
+   * handed to it so they land in that thread — a conversation that erases itself when
+   * you put the phone down is the part you most want to re-read, and it is also what
+   * the typed model reads as context on the next turn.
+   */
+  adoptRef: React.MutableRefObject<((spoken: UIMessage[]) => void) | null>
+}
+
+export function useVoiceController(): VoiceController {
+  const [session, setSession] = useState<{ stream: MediaStream; instructions: string } | null>(null)
+  const [messages, setMessages] = useState<UIMessage[]>([])
+  const [micError, setMicError] = useState<string | null>(null)
+  const adoptRef = useRef<((spoken: UIMessage[]) => void) | null>(null)
+
+  const start = useCallback((instructions: string) => {
+    setMicError(null)
+    // getUserMedia is started from inside the click/tap so Safari treats it as
+    // gestured; deferring it until after the token round-trip loses that and the
+    // permission prompt never appears.
+    navigator.mediaDevices.getUserMedia({ audio: true }).then(
+      (stream) => {
+        setMessages([])
+        setSession({ stream, instructions })
+      },
+      (e: Error) => setMicError(e.message),
+    )
+  }, [])
+
+  const stop = useCallback(() => {
+    setSession(null)
+    setMessages((spoken) => {
+      if (spoken.length > 0) {
+        adoptRef.current?.(spoken)
+      }
+      return []
+    })
+  }, [])
+
+  return { session, messages, setMessages, micError, start, stop, adoptRef }
+}
