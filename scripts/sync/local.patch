@@ -0,0 +1,72 @@
+// The notifications opt-in, shown in the console's footer.
+//
+// It states the iOS Home Screen requirement plainly instead of offering a button
+// that would silently fail there — the one step in this whole feature that only
+// the operator can perform.
+
+import { Bell, BellOff, BellRing, Loader2, Share, TriangleAlert } from "lucide-react"
+import { cn } from "@/lib/utils"
+import { usePushOptIn } from "./usePushOptIn"
+
+export function PushOptIn({ className }: { className?: string }) {
+  const { state, enable, disable, busy } = usePushOptIn()
+
+  if (state.kind === "unsupported") {
+    return null // nothing actionable to offer; a dead control is worse than none
+  }
+
+  if (state.kind === "needs-install") {
+    return (
+      <p className={cn("flex items-start gap-1.5 text-[11px] leading-snug text-muted-foreground", className)}>
+        <Share className="mt-px size-3 shrink-0" />
+        <span>
+          To get answers when this tab is closed: <span className="text-foreground">Share → Add to Home Screen</span>, then open the console from there and turn
+          notifications on.
+        </span>
+      </p>
+    )
+  }
+
+  if (state.kind === "blocked") {
+    return (
+      <p className={cn("flex items-center gap-1.5 text-[11px] text-muted-foreground", className)}>
+        <BellOff className="size-3 shrink-0" /> Notifications are blocked for this site in your browser settings.
+      </p>
+    )
+  }
+
+  // A pruned subscription is not the same as "off", and it must not render as one.
+  // Off is a choice the operator made; this is the feature having stopped working without
+  // anything being said — the phone goes quiet and the toggle still looks fine. So it
+  // says what happened and what the one tap will do, in the failure's own colour.
+  if (state.kind === "stale") {
+    return (
+      <button
+        className={cn("flex items-center gap-1.5 rounded-full px-2 py-1 text-left text-[11px] leading-snug text-destructive transition-colors hover:text-destructive/80", className)}
+        disabled={busy}
+        onClick={() => void enable()}
+        type="button"
+      >
+        {busy ? <Loader2 className="size-3 shrink-0 animate-spin" /> : <TriangleAlert className="size-3 shrink-0" />}
+        Notifications stopped reaching this device — tap to turn them back on
+      </button>
+    )
+  }
+
+  const on = state.kind === "subscribed"
+  return (
+    <button
+      className={cn(
+        "flex items-center gap-1.5 rounded-full px-2 py-1 text-[11px] transition-colors",
+        on ? "text-primary" : "text-muted-foreground hover:text-foreground",
+        className,
+      )}
+      disabled={busy}
+      onClick={() => void (on ? disable() : enable())}
+      type="button"
+    >
+      {busy ? <Loader2 className="size-3 animate-spin" /> : on ? <BellRing className="size-3" /> : <Bell className="size-3" />}
+      {on ? `Notifications on${state.devices > 1 ? ` · ${state.devices} devices` : ""}` : "Notify me when answers arrive"}
+    </button>
+  )
+}
diff --git a/agent-mesh/dashboard/src/console/ThreadView.tsx b/agent-mesh/dashboard/src/console/ThreadView.tsx
new file mode 100644
index 0000000..384d6a0
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/ThreadView.tsx
@@ -0,0 +1,184 @@
+// A direct mesh conversation with one agent — the messaging half of the console.
+//
+// Nothing here goes through a model: what you type is published verbatim as a mesh
+// message from your operator id. The composer is AI Elements' PromptInput so
+// the two surfaces feel like one product, but the wire is plain /api/publish.
+
+import { Conversation, ConversationContent, ConversationEmptyState, ConversationScrollButton } from "@/components/ai-elements/conversation"
+import { Message, MessageContent, MessageResponse } from "@/components/ai-elements/message"
+import { PromptInput, PromptInputBody, PromptInputFooter, PromptInputSubmit, PromptInputTextarea, PromptInputTools } from "@/components/ai-elements/prompt-input"
+import { Radio, TriangleAlert } from "lucide-react"
+import { useEffect, useRef, useState } from "react"
+import { MESSAGE_TYPES, type MeshMessage } from "@/lib/api"
+import { dayLabel, sameDay, TYPE_STYLE } from "@/lib/format"
+import { cn } from "@/lib/utils"
+import { bodyToText, sendMeshMessage } from "./console-api"
+
+type Props = {
+  peer: string
+  me: string
+  messages: MeshMessage[]
+  sendOnly: boolean
+  loading: boolean
+  onSent: (id: string) => void
+}
+
+/** Optimistic rows carry a temporary stream id so they can be reconciled on the next poll. */
+type Pending = { key: string; text: string; type: MeshMessage["type"]; at: string; failed: string | null }
+
+export function ThreadView({ peer, me, messages, sendOnly, loading, onSent }: Props) {
+  const [type, setType] = useState<MeshMessage["type"]>("note")
+  const [pending, setPending] = useState<Pending[]>([])
+  const seenIds = useRef(new Set<string>())
+
+  // Drop an optimistic row once its real counterpart comes back from the server.
+  // Matching on text rather than id is the only option — publish returns the id
+  // but the poll that carries the row may land first, and a duplicate bubble is
+  // more confusing than a half-second of the optimistic one.
+  useEffect(() => {
+    if (pending.length === 0) {
+      return
+    }
+    const landed = new Set(messages.filter((m) => m.from === me).map((m) => bodyToText(m.body)))
+    setPending((prev) => prev.filter((p) => p.failed != null || !landed.has(p.text)))
+  }, [messages, me, pending.length])
+
+  useEffect(() => {
+    setPending([])
+    seenIds.current = new Set()
+  }, [peer])
+
+  const send = async (text: string) => {
+    const key = `pending-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`
+    setPending((prev) => [...prev, { key, text, type, at: new Date().toISOString(), failed: null }])
+    try {
+      const res = await sendMeshMessage({ me, to: peer, type, text, correlationId: null })
+      onSent(res.id)
+    } catch (e) {
+      setPending((prev) => prev.map((p) => (p.key === key ? { ...p, failed: (e as Error).message } : p)))
+    }
+  }
+
+  return (
+    <div className="flex min-h-0 flex-1 flex-col">
+      <Conversation className="mesh-scroll min-h-0 flex-1">
+        <ConversationContent className="gap-3 px-3 py-4">
+          {messages.length === 0 && pending.length === 0 && !loading && (
+            <ConversationEmptyState
+              description={
+                sendOnly
+                  ? "A host fan-out reaches every agent on that machine. Messages send, but the host stream has no readable history — what you send from here is shown until you leave."
+                  : "Nothing between you and this agent yet."
+              }
+              icon={<Radio className="size-6" />}
+              title={sendOnly ? "Host fan-out" : "No messages"}
+            />
+          )}
+
+          {messages.map((m, i) => {
+            const prev = i > 0 ? messages[i - 1] : null
+            const newDay = prev == null || !sameDay(prev.ts, m.ts)
+            return (
+              <div key={`${m.channel}:${m.id}`}>
+                {newDay && <p className="py-2 text-center text-[11px] uppercase tracking-wide text-muted-foreground/70">{dayLabel(m.ts)}</p>}
+                <MeshBubble me={me} message={m} />
+              </div>
+            )
+          })}
+
+          {pending.map((p) => (
+            <Message from="user" key={p.key}>
+              <MessageContent
+                className={cn(
+                  "group-[.is-user]:max-w-[88%] group-[.is-user]:rounded-2xl group-[.is-user]:rounded-br-md group-[.is-user]:px-3.5 group-[.is-user]:py-2.5 group-[.is-user]:text-[15px]",
+                  p.failed != null
+                    ? "group-[.is-user]:bg-destructive/15 group-[.is-user]:text-destructive"
+                    : "group-[.is-user]:bg-primary/70 group-[.is-user]:text-primary-foreground",
+                )}
+              >
+                <p className="whitespace-pre-wrap leading-snug">{p.text}</p>
+                <p className="mt-1 flex items-center gap-1 text-[10.5px] opacity-80">
+                  {p.failed != null ? (
+                    <>
+                      <TriangleAlert className="size-3" /> {p.failed}
+                    </>
+                  ) : (
+                    "sending…"
+                  )}
+                </p>
+              </MessageContent>
+            </Message>
+          ))}
+        </ConversationContent>
+        <ConversationScrollButton />
+      </Conversation>
+
+      <div className="mesh-safe-bottom border-t border-border/70 bg-card/70 px-3 pt-2.5 backdrop-blur-xl">
+        <PromptInput
+          onSubmit={(msg) => {
+            if (msg.text.trim() === "") {
+              return
+            }
+            void send(msg.text.trim())
+          }}
+        >
+          <PromptInputBody>
+            <PromptInputTextarea placeholder={`Message ${peer}…`} />
+          </PromptInputBody>
+          <PromptInputFooter className="flex-wrap gap-y-1.5">
+              <PromptInputTools className="flex-wrap gap-1">
+                {MESSAGE_TYPES.map((t) => (
+                  <button
+                    className={cn(
+                      "shrink-0 rounded-full border px-2.5 py-1 text-[12px] transition-colors",
+                      type === t ? "border-transparent text-background" : "border-border/60 text-muted-foreground",
+                    )}
+                    key={t}
+                    onClick={() => setType(t)}
+                    style={type === t ? { backgroundColor: TYPE_STYLE[t].color } : undefined}
+                    type="button"
+                  >
+                    {t}
+                  </button>
+                ))}
+              </PromptInputTools>
+              <PromptInputSubmit className="size-9 shrink-0 rounded-full" status="ready" />
+          </PromptInputFooter>
+        </PromptInput>
+      </div>
+    </div>
+  )
+}
+
+function MeshBubble({ message, me }: { message: MeshMessage; me: string }) {
+  const mine = message.from === me
+  const style = TYPE_STYLE[message.type]
+  const text = bodyToText(message.body)
+  const at = new Date(message.ts).toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" })
+
+  return (
+    <Message from={mine ? "user" : "assistant"}>
+      <MessageContent
+        className={cn(
+          "max-w-[88%] rounded-2xl px-3.5 py-2.5",
+          mine
+            ? "group-[.is-user]:rounded-br-md group-[.is-user]:bg-primary group-[.is-user]:px-3.5 group-[.is-user]:py-2.5 group-[.is-user]:text-primary-foreground"
+            : "rounded-bl-md border border-border/60 bg-card",
+        )}
+      >
+        <div className="flex items-center gap-1.5">
+          <span className="text-[10.5px] font-semibold uppercase tracking-wide" style={{ color: mine ? undefined : style.color }}>
+            {message.type}
+          </span>
+          {!mine && <span className="truncate font-mono text-[10.5px] text-muted-foreground">{message.from}</span>}
+          {message.to === "broadcast" && <span className="rounded-full border border-border/60 px-1.5 text-[10px] text-muted-foreground">broadcast</span>}
+          <span className={cn("ml-auto shrink-0 text-[10.5px] tabular", mine ? "text-primary-foreground/70" : "text-muted-foreground")}>{at}</span>
+        </div>
+        <MessageResponse className={cn("mesh-prose mt-1", mine && "text-primary-foreground")}>{text}</MessageResponse>
+        {message.correlationId != null && (
+          <p className={cn("mt-1 font-mono text-[10px]", mine ? "text-primary-foreground/60" : "text-muted-foreground/70")}>corr {message.correlationId}</p>
+        )}
+      </MessageContent>
+    </Message>
+  )
+}
diff --git a/agent-mesh/dashboard/src/console/Threads.tsx b/agent-mesh/dashboard/src/console/Threads.tsx
new file mode 100644
index 0000000..3487118
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/Threads.tsx
@@ -0,0 +1,172 @@
+// The conversation list, in two parts.
+//
+// TOP: threads that exist — every agent that has written to the operator, newest first,
+// plus anyone they have written to from this phone. The server can only derive the
+// first half: a mesh message lands in the RECIPIENT's stream, so an agent they have
+// only ever sent to leaves no trace in their own inbox. The ids they have sent to are
+// remembered locally and merged in, which is what stops a thread from vanishing the
+// moment it is started.
+//
+// BELOW: the rest of the roster. Without it the screen is empty on a quiet day even
+// though many agents are registered, and there would be no way to start a thread
+// with one from the phone at all — the console can only reach an agent they can name.
+
+import { Radio, Search, Server, User } from "lucide-react"
+import { useMemo, useState } from "react"
+import type { AgentRecord } from "@/lib/api"
+import { relTime, TYPE_STYLE } from "@/lib/format"
+import { StatusDot } from "@/components/ui/core"
+import { cn } from "@/lib/utils"
+import type { ConversationSummary } from "./console-api"
+import { splitAgentId } from "./console-api"
+
+type Props = {
+  peers: ConversationSummary[]
+  agents: AgentRecord[]
+  hostname: string
+  sentTo: string[]
+  onOpen: (peer: string) => void
+}
+
+type Row = {
+  id: string
+  preview: string | null
+  ts: string | null
+  type: ConversationSummary["lastType"] | null
+  unread: number
+  agent: AgentRecord | undefined
+}
+
+// The roster can run to hundreds across everyone's machines. Showing all of it unfiltered
+// is a wall; this host's live agents are the ones the operator actually reaches for, and the
+// filter box opens up the rest.
+const ROSTER_PREVIEW = 25
+
+export function Threads({ peers, agents, hostname, sentTo, onOpen }: Props) {
+  const [q, setQ] = useState("")
+  const query = q.trim().toLowerCase()
+  const byId = useMemo(() => new Map(agents.map((a) => [a.id, a])), [agents])
+
+  const threads = useMemo<Row[]>(() => {
+    const seen = new Set(peers.map((p) => p.id))
+    const fromInbox: Row[] = peers.map((p) => ({ id: p.id, preview: p.preview, ts: p.lastTs, type: p.lastType, unread: p.unreadFrom, agent: byId.get(p.id) }))
+    const sendOnly: Row[] = sentTo
+      .filter((id) => !seen.has(id))
+      .map((id) => ({ id, preview: null, ts: null, type: null, unread: 0, agent: byId.get(id) }))
+    return [...fromInbox, ...sendOnly]
+  }, [peers, sentTo, byId])
+
+  const rest = useMemo<Row[]>(() => {
+    const taken = new Set(threads.map((r) => r.id))
+    return agents
+      .filter((a) => !taken.has(a.id))
+      .sort((a, b) => {
+        // Local + online first, then most recently seen: the ordering that puts the
+        // agent the operator is thinking about at the top without them typing anything.
+        const score = (x: AgentRecord) => (x.host === hostname ? 2 : 0) + (x.status === "online" ? 1 : 0)
+        return score(b) - score(a) || b.lastSeen.localeCompare(a.lastSeen)
+      })
+      .map((a) => ({ id: a.id, preview: a.role, ts: a.lastSeen, type: null, unread: 0, agent: a }))
+  }, [agents, threads, hostname])
+
+  const matches = (r: Row) => query === "" || r.id.toLowerCase().includes(query) || (r.agent?.role ?? "").toLowerCase().includes(query)
+  const shownThreads = threads.filter(matches)
+  const shownRest = rest.filter(matches).slice(0, query === "" ? ROSTER_PREVIEW : 60)
+
+  return (
+    <div className="mesh-scroll min-h-0 flex-1 overflow-y-auto">
+      <div className="sticky top-0 z-10 border-b border-border/60 bg-background/90 px-3 py-2.5 backdrop-blur-xl">
+        <div className="flex items-center gap-2 rounded-xl border border-border bg-card/60 px-3">
+          <Search className="size-4 shrink-0 text-muted-foreground" />
+          <input
+            className="h-10 w-full bg-transparent font-mono text-foreground outline-none placeholder:font-sans placeholder:text-muted-foreground/70"
+            onChange={(e) => setQ(e.target.value)}
+            placeholder={`Filter ${agents.length} agents…`}
+            value={q}
+          />
+        </div>
+      </div>
+
+      {query === "" && (
+        <button className="flex w-full items-center gap-3 border-b border-border/50 px-3 py-3.5 text-left active:bg-accent/50" onClick={() => onOpen("broadcast")} type="button">
+          <span className="grid size-10 shrink-0 place-items-center rounded-full bg-primary/15 text-primary">
+            <Radio className="size-4.5" />
+          </span>
+          <span className="min-w-0 flex-1">
+            <span className="block text-[15px] font-medium">broadcast</span>
+            <span className="block truncate text-[13px] text-muted-foreground">Everything on the mesh-wide channel</span>
+          </span>
+        </button>
+      )}
+
+      {shownThreads.length > 0 && (
+        <>
+          <SectionLabel>Conversations</SectionLabel>
+          <RowList onOpen={onOpen} rows={shownThreads} />
+        </>
+      )}
+
+      {shownRest.length > 0 && (
+        <>
+          <SectionLabel>{query === "" ? `Agents on ${hostname}` : `${shownRest.length} matching agents`}</SectionLabel>
+          <RowList onOpen={onOpen} rows={shownRest} />
+        </>
+      )}
+
+      {shownThreads.length === 0 && shownRest.length === 0 && (
+        <p className="px-4 py-10 text-center text-sm text-muted-foreground">Nothing matching “{q}”.</p>
+      )}
+      <div className="mesh-safe-bottom h-2" />
+    </div>
+  )
+}
+
+function SectionLabel({ children }: { children: React.ReactNode }) {
+  return <p className="bg-muted/40 px-3 py-1.5 text-[11px] font-medium uppercase tracking-wide text-muted-foreground">{children}</p>
+}
+
+function RowList({ rows, onOpen }: { rows: Row[]; onOpen: (peer: string) => void }) {
+  return (
+    <ul>
+      {rows.map((row) => {
+        const { scope, leaf } = splitAgentId(row.id)
+        const isHost = row.id.startsWith("host:")
+        return (
+          <li key={row.id}>
+            <button className="flex w-full items-center gap-3 border-b border-border/50 px-3 py-3 text-left active:bg-accent/50" onClick={() => onOpen(row.id)} type="button">
+              <span className="relative grid size-10 shrink-0 place-items-center rounded-full border border-border/70 bg-card/60 text-muted-foreground">
+                {isHost ? <Server className="size-4.5" /> : <User className="size-4.5" />}
+                {row.agent != null && (
+                  <span className="absolute -right-0.5 -bottom-0.5 rounded-full bg-background p-0.5">
+                    <StatusDot status={row.agent.status} />
+                  </span>
+                )}
+              </span>
+
+              <span className="min-w-0 flex-1">
+                <span className="flex items-baseline gap-2">
+                  <span className="min-w-0 flex-1 truncate font-mono text-[14px] font-medium">
+                    {scope != null && <span className="text-muted-foreground/70">{scope}.</span>}
+                    {leaf}
+                  </span>
+                  {row.ts != null && <span className="shrink-0 text-[11px] tabular text-muted-foreground">{relTime(row.ts)}</span>}
+                </span>
+                <span className="mt-0.5 flex items-center gap-1.5">
+                  {row.type != null && (
+                    <span className="shrink-0 text-[10.5px] font-medium uppercase tracking-wide" style={{ color: TYPE_STYLE[row.type].color }}>
+                      {row.type}
+                    </span>
+                  )}
+                  <span className={cn("min-w-0 flex-1 truncate text-[13px]", row.preview != null ? "text-muted-foreground" : "text-muted-foreground/60 italic")}>
+                    {row.preview ?? "no messages yet"}
+                  </span>
+                  {row.unread > 0 && <span className="shrink-0 rounded-full bg-primary px-1.5 py-px text-[10.5px] font-semibold text-primary-foreground tabular">{row.unread}</span>}
+                </span>
+              </span>
+            </button>
+          </li>
+        )
+      })}
+    </ul>
+  )
+}
diff --git a/agent-mesh/dashboard/src/console/VoiceSession.tsx b/agent-mesh/dashboard/src/console/VoiceSession.tsx
new file mode 100644
index 0000000..4a92e38
--- /dev/null
+++ b/agent-mesh/dashboard/src/console/VoiceSession.tsx
@@ -0,0 +1,195 @@
+// The hands-free half of the console.
+//
+// This component is MOUNTED ONLY WHILE A VOICE SESSION IS WANTED, and that is
+// load-bearing rather than tidy: `useRealtime` memoizes its session on the
+// identity of `sessionConfig`, so a config rebuilt on any later render would
+// silently tear down the live session mid-sentence. Mounting fresh per session
+// means each one is built from the roster as it is right now and then frozen.
+
+import { Experimental_OpenAIRealtimeModel } from "@ai-sdk/openai"
+import { experimental_useRealtime } from "@ai-sdk/react"
+import type { Experimental_RealtimeSessionConfig, UIMessage } from "ai"
+import { Loader2, Mic, MicOff, Square, Volume2 } from "lucide-react"
+import { useEffect, useMemo, useRef, useState } from "react"
+import { consoleApi, type ConsoleConfig } from "./console-api"
+import { cn } from "@/lib/utils"
+
+type VoicePhase = "connecting" | "listening" | "speaking" | "error" | "closed"
+
+type Props = {
+  config: ConsoleConfig
+  instructions: string
+  /** Acquired in the tap handler, because iOS only grants the mic inside a gesture. */
+  stream: MediaStream
+  onMessages: (messages: UIMessage[]) => void
+  onOpenThread: (agent: string) => void
+  onStop: () => void
+}
+
+export function VoiceSession({ config, instructions, stream, onMessages, onOpenThread, onStop }: Props) {
+  const [error, setError] = useState<string | null>(null)
+  const [needsGesture, setNeedsGesture] = useState(false)
+
+  // The browser half of the provider never needs a real credential: it only
+  // serializes events and derives the websocket subprotocol. The ephemeral token
+  // comes from /api/console/realtime-session, which is where the real key lives.
+  const model = useMemo(
+    () =>
+      new Experimental_OpenAIRealtimeModel(config.voice.model, {
+        provider: "openai.realtime",
+        baseURL: "https://api.openai.com/v1",
+        headers: () => ({}),
+      }),
+    [config.voice.model],
+  )
+
+  // Frozen for the life of this mount — see the header.
+  const [sessionConfig] = useState<Partial<Experimental_RealtimeSessionConfig>>(() => ({
+    instructions,
+    voice: config.voice.voice,
+    outputModalities: ["audio"],
+    // Semantic VAD reads intent rather than silence, which is what makes this
+    // usable outdoors: a plain silence timer cuts the operator off every time they pause to
+    // think, and raising the timer to compensate makes every reply feel late.
+    turnDetection: { type: "semantic-vad" },
+    inputAudioTranscription: { model: config.voice.transcribeModel },
+  }))
+
+  const realtime = experimental_useRealtime({
+    model,
+    api: { token: "/api/console/realtime-session" },
+    sessionConfig,
+    onToolCall: async ({ toolCall }) => {
+      if (toolCall.toolName === "open_thread") {
+        const agent = (toolCall.args as { agent?: string } | null)?.agent
+        if (typeof agent === "string" && agent !== "") {
+          onOpenThread(agent)
+        }
+      }
+      return consoleApi.runTool(toolCall.toolName, toolCall.args)
+    },
+    onError: (e) => setError(e.message),
+  })
+
+  // Deliberately keyed on the mount alone, with a guard: one connection per
+  // session. Adding `realtime` to the deps would reconnect on every store change
+  // and OpenAI bills — and interrupts — per connection.
+  const connectedRef = useRef(false)
+  useEffect(() => {
+    if (connectedRef.current) {
+      return
+    }
+    connectedRef.current = true
+    realtime
+      .connect({ stream })
+      // `connect` only STORES the supplied stream; capture and playback each need
+      // their own resume, and without them the session comes up connected, silent
+      // and deaf — the failure mode that looks exactly like a working session.
+      .then(() => Promise.all([realtime.resumePlayback(), realtime.resumeAudioCapture()]))
+      .catch((e: Error) => {
+        // Safari only starts an AudioContext from inside a user gesture, and the
+        // resumes above run a few microtasks after the tap that mounted this. When
+        // that window has closed the bar offers an explicit tap instead of dying.
+        setNeedsGesture(true)
+        setError(e.message)
+      })
+    return () => {
+      realtime.disconnect()
+      for (const track of stream.getTracks()) {
+        track.stop()
+      }
+    }
+  }, [])
+
+  useEffect(() => {
+    onMessages(realtime.messages)
+  }, [realtime.messages, onMessages])
+
+  const unlock = () => {
+    setError(null)
+    setNeedsGesture(false)
+    void Promise.all([realtime.resumePlayback(), realtime.resumeAudioCapture()]).catch((e: Error) => {
+      setNeedsGesture(true)
+      setError(e.message)
+    })
+  }
+
+  const phase: VoicePhase =
+    error != null || realtime.status === "error"
+      ? "error"
+      : realtime.status === "connecting"
+        ? "connecting"
+        : realtime.status === "disconnected"
+          ? "closed"
+          : realtime.isPlaying
+            ? "speaking"
+            : "listening"
+
+  const label =
+    phase === "error"
+      ? (error ?? "voice failed")
+      : phase === "connecting"
+        ? "connecting…"
+        : phase === "speaking"
+          ? "speaking"
+          : phase === "closed"
+            ? "disconnected"
+            : realtime.isCapturing
+              ? "listening"
+              : needsGesture
+                ? "tap the mic to enable audio"
+                : "mic muted — tap to resume"
+
+  return (
+    <div className="mesh-safe-bottom border-t border-border/70 bg-card/80 px-3 pt-3 backdrop-blur-xl">
+      <div className="flex items-center gap-3">
+        <button
+          aria-label={realtime.isCapturing ? "Mute microphone" : "Unmute microphone"}
+          className={cn(
+            "grid size-12 shrink-0 place-items-center rounded-full",
+            phase === "error" ? "bg-destructive/15 text-destructive" : "bg-primary/15 text-primary",
+            phase === "listening" && realtime.isCapturing && "animate-meshbreathe",
+            phase === "speaking" && "animate-meshbreathe-fast",
+          )}
+          onClick={() => (realtime.isCapturing ? realtime.stopAudioCapture() : unlock())}
+          type="button"
+        >
+          {phase === "connecting" ? (
+            <Loader2 className="size-5 animate-spin" />
+          ) : phase === "speaking" ? (
+            <Volume2 className="size-5" />
+          ) : phase === "error" || phase === "closed" || !realtime.isCapturing ? (
+            <MicOff className="size-5" />
+          ) : (
+            <Mic className="size-5" />
+          )}
+        </button>
+
+        <div className="min-w-0 flex-1">
+          <p className={cn("truncate text-sm font-medium", phase === "error" ? "text-destructive" : "text-foreground")}>{label}</p>
+          <p className="truncate text-[11px] text-muted-foreground">
+            {config.voice.model} · {config.voice.voice}
+          </p>
+        </div>
+
+        {phase === "speaking" && (
+          <button
+            className="rounded-full border border-border px-3 py-2 text-xs text-muted-foreground active:bg-accent"
+            onClick={() => realtime.cancelResponse()}
+            type="button"
+          >
+            skip
+          </button>
+        )}
+        <button
+          aria-label="End voice session"
+          className="grid size-12 shrink-0 place-items-center rounded-full bg-destructive/15 text-destructive active:bg-destructive/25"
+          onClick={onStop}
+          type="button"
+        >
+          <Square className="size-4 fill-current" />
+        </button>
+      </div>
+    </div>
+  )
+}
